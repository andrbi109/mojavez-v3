# Set up automatic line-ending and diff handling for the mojavez-v3 repo.
# Persian text in docs/views must round-trip cleanly across Windows/Linux/macOS.

* text=auto eol=lf

*.php  text eol=lf
*.phtml text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.csv  text eol=lf workingfile-encoding=utf-8
*.env* text eol=lf
*.conf text eol=lf

# Binary assets — never diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.pdf  binary
*.zip  binary
*.har  binary
*.mp4  binary
*.webm binary

# Linguist hints — GitHub language stats
*.php linguist-language=PHP
*.phtml linguist-language=PHP
docs/* linguist-documentation
