# mojavez-v3 — Docker deployment environment defaults.
# Copy to .env and edit before `docker compose up -d --build`.

# --- Database ---
DB_ROOT_PASSWORD=change_me_root
DB_NAME=mojavez_v3
DB_USER=mojavez
DB_PASSWORD=change_me_pass

# --- App ---
APP_ENV=production
INIT_DB=1

# Exposed port for the nginx `web` service (host side).
MOJAVEZ_PORT=8080

# --- Secrets (generate with: openssl rand -hex 32) ---
CRON_SECRET=
SYNC_SECRET=
GATEWAY_API_KEY=

# --- Initial admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Upstream national gateway ---
# Leave blank to use defaults (qr.mojavez.ir). Only set if you need to point
# at a mirror or staging instance.
NATIONAL_GATEWAY_BASE_URL=
