# ===========================================================================
# mojavez-v3 — example environment file
# Copy to .env and fill in real values. Never commit .env to git.
# All variables here are read by app/Shared/Support/Environment.php.
# ===========================================================================

# ----- Application -----
# production | staging | development | local
APP_ENV=production
# When true, full errors shown. Read ONLY from .env (never from code constant).
APP_DEBUG=false
# Base URL for internal links (no trailing slash).
APP_URL=http://localhost:8000
# Base path if app is mounted under a sub-path. Examples: /, /public/, /mojavez/
BASE_URL=/

# ----- Database (MySQL/MariaDB) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mojavez_v3
DB_USER=root
DB_PASS=

# ----- Sessions / rate limit -----
# Session lifetime in seconds (86400 = 24h)
SESSION_LIFETIME=86400
# Public endpoint rate limit per minute
PUBLIC_RATE_LIMIT_PER_MIN=30
# In v3 defaults to true (fixes v2 weakness: tracking code alone was enough)
TRACKING_REQUIRE_MOBILE=true
# Comma-separated admin IP allowlist (empty = any IP)
ADMIN_IP_ALLOWLIST=
# Comma-separated IP blocklist (early 403 exit)
IP_BLOCKLIST=

# ----- Secrets (use `openssl rand -hex 32`) -----
# Protects /check-cancel (auto-cancel cron trigger)
CRON_SECRET=
# Protects /check-sync (golden-link cycle trigger)
SYNC_SECRET=
# Legacy single API key for /api/v1/applicants/* (kept for backward compat
# until scope-based api_keys table is fully wired in Phase 6).
GATEWAY_API_KEY=

# ----- SMS gateway (Kavenegar-compatible) -----
# Leave empty in non-production → SMS is logged to storage/logs/sms.log
# instead of being sent (dev mode, no real network call).
# Get an API key from https://kavenegar.com (Iranian SMS provider).
# Sender is your Kavenegar line number (e.g. 3000123456).
SMS_API_KEY=
SMS_SENDER=

# ----- Errors / logging -----
# Path outside DocumentRoot. Empty = PHP default (only for dev).
ERROR_LOG_PATH=

# ----- Upstream national gateway (qr.mojavez.ir) -----
UPSTREAM_BASE=https://qr.mojavez.ir
# Geofence: scraper only works from inside Iran (R2).
# Outside Iran, use HAR fixtures + mock HTTP in tests.
UPSTREAM_RATE_LIMIT_PER_MIN=30
UPSTREAM_MIN_DELAY_MS=2000
UPSTREAM_MAX_DELAY_MS=5000
UPSTREAM_TIMEOUT_CONNECT=5
UPSTREAM_TIMEOUT_RESPONSE=8

# ----- Golden link / sync cycle -----
SYNC_CYCLE_INTERVAL_MIN=60
SYNC_AUTO_CONFIRM_THRESHOLD=90
SYNC_OPERATOR_FLAG_THRESHOLD=50

# ----- Cache TTLs (seconds) -----
CACHE_TTL_SEARCH_SECONDS=1800
CACHE_TTL_LOOKUPS_SECONDS=86400
CACHE_TTL_COUNT_SECONDS=3600
