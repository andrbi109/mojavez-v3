            "mimeType": "application/javascript",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway - Main Application Logic\n   Vanilla JS, no frameworks, no build tools\n   ============================================ */\n\n(function () {\n  'use strict';\n\n  /* ---- App state + config ---- */\n  const App = {\n    state: {\n      view: 'cards', filters: {},\n      sort: { field: 'responded_at', dir: 'desc' },\n      page: 1, pageSize: 20, total: 0, items: [], loading: false,\n      viewingSaved: false  // true = showing only is_saved=1 licenses\n    },\n    config: { apiBase: '/api', csrfToken: null, defaultPageSize: 20 }\n  };\n\n  /* ---- XSS-safe HTML escape ---- */\n  function escapeHtml(str) {\n    if (str === null || str === undefined) return '';\n    return String(str)\n      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n  }\n\n  /* ---- CSRF token detection ---- */\n  function detectCsrfToken() {\n    const meta = document.querySelector('meta[name=\"csrf-token\"]');\n    if (meta) App.config.csrfToken = meta.getAttribute('content');\n  }\n\n  /* ---- API helper: returns Promise, uses fetch + CSRF header ---- */\n  /* ---- Includes a 25s timeout via AbortController so the UI never hangs ---- */\n  /* ---- indefinitely if the backend gets stuck on a slow upstream call.   ---- */\n  async function api(method, url, body, opts) {\n    opts = opts || {};\n    const fullUrl = url.startsWith('http') || url.startsWith('/api')\n      ? url : App.config.apiBase + '/' + url.replace(/^\\//, '');\n    const init = {\n      method: method.toUpperCase(),\n      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },\n      credentials: 'same-origin'\n    };\n    if (App.config.csrfToken) init.headers['X-CSRF-Token'] = App.config.csrfToken;\n    if (body !== undefined && body !== null) {\n      if (body instanceof FormData) { init.body = body; }\n      else { init.headers['Content-Type'] = 'application/json'; init.body = JSON.stringify(body); }\n    }\n\n    // Timeout: 25s. Backend should respond within ~13s (5s connect + 8s response\n    // worst case). 25s gives generous headroom for slow networks but still\n    // prevents the UI from hanging for 90s+ like before.\n    const timeoutMs = opts.timeout || 25000;\n    const controller = new AbortController();\n    const timer = setTimeout(() => controller.abort(), timeoutMs);\n    init.signal = controller.signal;\n\n    let res;\n    try {\n      res = await fetch(fullUrl, init);\n    } catch (e) {\n      clearTimeout(timer);\n      if (e.name === 'AbortError') {\n        throw new Error('زمان پاسخ سرور به پایان رسید (Timeout). لطفاً دوباره تلاش کنید.');\n      }\n      throw new Error('خطا در ارتباط با سرور: ' + (e.message || 'نامشخص'));\n    }\n    clearTimeout(timer);\n\n    if (opts.raw) return res;\n    const ct = res.headers.get('content-type') || '';\n    if (!res.ok) {\n      let msg = 'خطای سرور (' + res.status + ')';\n      try {\n        if (ct.includes('application/json')) {\n          const err = await res.json();\n          msg = err.message || err.error || msg;\n        } else {\n          const txt = await res.text();\n          if (txt) msg = txt.substring(0, 200);\n        }\n      } catch (_) {}\n      const e = new Error(msg); e.status = res.status; throw e;\n    }\n    if (ct.includes('application/json')) return res.json();\n    if (ct.includes('text/')) return res.text();\n    return res.blob();\n  }\n\n  /* ---- Toast helper (stacked, auto-dismiss after 5s) ---- */\n  function toast(message, type, duration) {\n    type = type || 'info'; duration = duration || 5000;\n    let stack = document.querySelector('.toast-stack');\n    if (!stack) {\n      stack = document.createElement('div');\n      stack.className = 'toast-stack';\n      document.body.appendChild(stack);\n    }\n    const el = document.createElement('div');\n    el.className = 'toast toast--' + type;\n    const titleMap = { success: 'موفق', danger: 'خطا', warning: 'هشدار', info: 'اطلاع' };\n    el.innerHTML = '<span class=\"toast__title\">' + escapeHtml(titleMap[type] || 'اطلاع') +\n      '</span><span class=\"toast__body\">' + escapeHtml(message) + '</span>';\n    stack.appendChild(el);\n    const remove = () => { el.classList.add('is-leaving'); setTimeout(() => el.remove(), 220); };\n    const timer = setTimeout(remove, duration);\n    el.addEventListener('click', () => { clearTimeout(timer); remove(); });\n    return el;\n  }\n\n  /* ---- Modal helper (overlay + centered card) ---- */\n  function openModal(content, opts) {\n    opts = opts || {};\n    let overlay = document.querySelector('.modal-overlay');\n    if (!overlay) {\n      overlay = document.createElement('div');\n      overlay.className = 'modal-overlay';\n      document.body.appendChild(overlay);\n      overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });\n      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });\n    }\n    const sizeClass = opts.size === 'lg' ? ' modal--lg' : (opts.size === 'sm' ? ' modal--sm' : '');\n    overlay.innerHTML =\n      '<div class=\"modal' + sizeClass + '\" role=\"dialog\" aria-modal=\"true\">' +\n        '<div class=\"modal__header\"><div class=\"modal__title\">' + escapeHtml(opts.title || 'جزئیات') +\n          '</div><button class=\"modal__close\" aria-label=\"بستن\" data-close>&times;</button></div>' +\n        '<div class=\"modal__body\">' + content + '</div>' +\n        (opts.footer ? '<div class=\"modal__footer\">' + opts.footer + '</div>' : '') +\n      '</div>';\n    overlay.classList.add('is-open');\n    document.body.style.overflow = 'hidden';\n    const closeBtn = overlay.querySelector('[data-close]');\n    if (closeBtn) closeBtn.addEventListener('click', closeModal);\n    return overlay;\n  }\n\n  function closeModal() {\n    const overlay = document.querySelector('.modal-overlay');\n    if (overlay) { overlay.classList.remove('is-open'); overlay.innerHTML = ''; }\n    document.body.style.overflow = '';\n  }\n\n  /* ---- Jalali date conversion (Borkowski algorithm, ported from jalaali-js v2) ---- */\n  /* ---- The previous inline algorithm produced years 27 AHEAD of the correct ---- */\n  /* ---- Jalali date (e.g. 2026-02-23 → 1431/12/6 instead of 1404/12/4).         ---- */\n  /* ---- Verified against Intl.DateTimeFormat('fa-IR-u-ca-persian').             ---- */\n  function div(a, b) { return ~~(a / b); }   // Math.trunc integer division\n  function mod(a, b) { return a - ~~(a / b) * b; }  // mathematical modulo (always ≥0)\n\n  // Jalaali years that begin a new 33-year leap cycle (Borkowski BREAKS table).\n  const JALAALI_BREAKS = [\n    -61, 9, 38, 199, 426, 686, 756, 818, 1111, 1181, 1210, 1635,\n    2060, 2097, 2192, 2262, 2324, 2394, 2456, 3178\n  ];\n\n  // Core: locate year in cycle table + compute Farvardin 1's Gregorian date.\n  function jalCalCore(jy) {\n    const gy = jy + 621;\n    let leapJ = -14;\n    let jp = JALAALI_BREAKS[0];\n    let jm = 0, jump = 0;\n    for (let i = 1; i < JALAALI_BREAKS.length; i++) {\n      jm = JALAALI_BREAKS[i];\n      jump = jm - jp;\n      if (jy < jm) break;\n      leapJ = leapJ + div(jump, 33) * 8 + div(mod(jump, 33), 4);\n      jp = jm;\n    }\n    const n = jy - jp;\n    leapJ = leapJ + div(n, 33) * 8 + div(mod(n, 33) + 3, 4);\n    if (mod(jump, 33) === 4 && jump - n === 4) leapJ += 1;\n    const leapG = div(gy, 4) - div((div(gy, 100) + 1) * 3, 4) - 150;\n    return { gy, march: 20 + leapJ - leapG, jump, n };\n  }\n\n  function leapFromCycle(jump, n) {\n    let adjusted = n;\n    if (jump - n < 6) adjusted = n - jump + div(jump + 4, 33) * 33;\n    let leap = mod(mod(adjusted + 1, 33) - 1, 4);\n    if (leap === -1) leap = 4;\n    return leap;\n  }\n\n  function jalCal(jy) {\n    const { gy, march, jump, n } = jalCalCore(jy);\n    return { leap: leapFromCycle(jump, n), gy, march };\n  }\n\n  // Gregorian → Julian Day number.\n  function g2d(gy, gm, gd) {\n    let d = div((gy + div(gm - 8, 6) + 100100) * 1461, 4)\n          + div(153 * mod(gm + 9, 12) + 2, 5)\n          + gd - 34840408;\n    d = d - div(div(gy + 100100 + div(gm - 8, 6), 100) * 3, 4) + 752;\n    return d;\n  }\n\n  // Julian Day → Jalaali date.\n  function d2j(jdn) {\n    const gy = d2g(jdn).gy;\n    let jy = Math.min(gy - 621, JALAALI_BREAKS[JALAALI_BREAKS.length - 1] - 1);\n    const r = jalCal(jy);\n    let k = jdn - g2d(r.gy, 3, r.march);\n    if (k >= 0) {\n      if (k <= 185) return { jy, jm: 1 + div(k, 31), jd: mod(k, 31) + 1 };\n      k -= 186;\n    } else {\n      jy -= 1;\n      k += 179;\n      if (r.leap === 1) k += 1;\n    }\n    return { jy, jm: 7 + div(k, 30), jd: mod(k, 30) + 1 };\n  }\n\n  // Julian Day → Gregorian date.\n  function d2g(jdn) {\n    let j = 4 * jdn + 139361631;\n    j = j + div(div(4 * jdn + 183187720, 146097) * 3, 4) * 4 - 3908;\n    const i = div(mod(j, 1461), 4) * 5 + 308;\n    const gd = div(mod(i, 153), 5) + 1;\n    const gm = mod(div(i, 153), 12) + 1;\n    return { gy: div(j, 1461) - 100100 + div(8 - gm, 6), gm, gd };\n  }\n\n  // Gregorian (gy, gm, gd) → [jy, jm, jd]\n  function gregorianToJalali(gy, gm, gd) {\n    const r = d2j(g2d(gy, gm, gd));\n    return [r.jy, r.jm, r.jd];\n  }\n\n  const PERSIAN_MONTHS = ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور',\n    'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'];\n\n  function toPersianDigits(n) {\n    const fa = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];\n    return String(n).replace(/\\d/g, (d) => fa[+d]);\n  }\n\n  function toJalaliDate(input) {\n    if (!input) return '';\n    let s = String(input).trim();\n    if (!s || s === 'null' || s === 'undefined') return '';\n\n    // Normalize separators: accept '-', '/', '.', ' ' as date separators,\n    // and 'T' as the date/time boundary.\n    s = s.replace('T', ' ');\n    // Pick the date part (everything before the first space, or the whole thing)\n    const spaceIdx = s.indexOf(' ');\n    const datePart = spaceIdx >= 0 ? s.substring(0, spaceIdx) : s;\n    const timePart = spaceIdx >= 0 ? s.substring(spaceIdx + 1).trim() : '';\n\n    // Normalize to slash-separated y/m/d\n    const normalized = datePart.replace(/[-.]/g, '/');\n    const parts = normalized.split('/');\n    if (parts.length < 3) return escapeHtml(input);\n\n    let y = +parts[0], m = +parts[1], d = +parts[2];\n    if (!y || !m || !d) return escapeHtml(input);\n\n    // Detect Jalali vs Gregorian: Jalali years are 1300-1500, Gregorian 1900-2100.\n    if (y >= 1300 && y <= 1500) {\n      // Already Jalali — just format with Persian digits.\n      const out = toPersianDigits(y) + ' ' + PERSIAN_MONTHS[m - 1] + ' ' + toPersianDigits(d);\n      if (timePart) {\n        const t = timePart.split(':').slice(0, 2).join(':');\n        return out + ' - ' + toPersianDigits(t);\n      }\n      return out;\n    }\n\n    // Gregorian → convert (using the verified Borkowski algorithm above)\n    const j = gregorianToJalali(y, m, d);\n    const out = toPersianDigits(j[0]) + ' ' + PERSIAN_MONTHS[j[1] - 1] + ' ' + toPersianDigits(j[2]);\n    if (timePart) {\n      const t = timePart.split(':').slice(0, 2).join(':');\n      return out + ' - ' + toPersianDigits(t);\n    }\n    return out;\n  }\n\n  /* ---- Build query string ---- */\n  function buildQuery(params) {\n    const parts = [];\n    for (const k in params) {\n      if (!Object.prototype.hasOwnProperty.call(params, k)) continue;\n      const v = params[k];\n      if (v === null || v === undefined || v === '') continue;\n      if (Array.isArray(v)) {\n        v.forEach((item) => parts.push(encodeURIComponent(k) + '[]=' + encodeURIComponent(item)));\n      } else {\n        parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));\n      }\n    }\n    return parts.length ? '?' + parts.join('&') : '';\n  }\n\n  /* ---- Status bar helper (used by SSE) ---- */\n  function showStatusBar(text) {\n    const bar = document.querySelector('.app-status-bar');\n    if (!bar) return;\n    bar.querySelector('.app-status-bar__text').textContent = text;\n    bar.classList.add('is-visible');\n  }\n  function hideStatusBar() {\n    const bar = document.querySelector('.app-status-bar');\n    if (bar) bar.classList.remove('is-visible');\n  }\n\n  /* ---- View toggle (cards/table) persisted in localStorage ---- */\n  function setView(view) {\n    App.state.view = view;\n    try { localStorage.setItem('mojavez_view', view); } catch (_) {}\n    const cardsView = document.getElementById('cards-view');\n    const tableView = document.getElementById('table-view');\n    if (cardsView) cardsView.classList.toggle('hidden', view !== 'cards');\n    if (tableView) tableView.classList.toggle('hidden', view !== 'table');\n    document.querySelectorAll('.view-toggle__btn').forEach((btn) => {\n      const isActive = btn.dataset.view === view;\n      btn.classList.toggle('is-active', isActive);\n      // a11y: reflect active state to assistive tech\n      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');\n    });\n  }\n\n  function loadSavedView() {\n    let view = 'cards';\n    try { view = localStorage.getItem('mojavez_view') || 'cards'; } catch (_) {}\n    if (view !== 'cards' && view !== 'table') view = 'cards';\n    App.state.view = view;\n    return view;\n  }\n\n  /* ---- Filter form submit handler ---- */\n  function handleFilterSubmit(form) {\n    const fd = new FormData(form);\n    const filters = {};\n    for (const [k, v] of fd.entries()) { if (v !== '') filters[k] = v; }\n    App.state.filters = filters;\n    App.state.page = 1;\n    // Submitting a new filter always exits the \"saved\" view — a fresh search\n    // hits upstream and populates the cache with the new filter's results.\n    if (App.state.viewingSaved) {\n      viewAll();  // resets viewingSaved + toolbar state, then calls refreshCurrentView\n      return;\n    }\n    refreshCurrentView();\n  }\n\n  /* ---- Refresh current view: calls POST /api/licenses/search (upstream) ---- */\n  /* ---- First search fetches from qr.mojavez.ir, saves to local cache ---- */\n  async function refreshCurrentView() {\n    App.state.loading = true;\n    const body = {\n      page: App.state.page,\n      page_size: App.state.pageSize,\n      ...App.state.filters\n    };\n    if (App.state.view === 'cards' && window.MojavezCards) window.MojavezCards.renderLoading();\n    else if (window.MojavezTables) window.MojavezTables.renderLoading();\n    try {\n      showStatusBar('در حال جستجوی زنده در درگاه ملی مجوزها...');\n      const data = await api('POST', '/api/licenses/search', body);\n      App.state.items = (data.data || data.items || []).map(normalizeLicense);\n      App.state.total = data.total || App.state.items.length;\n      renderCurrentView();\n      updateCountDisplay();\n      hideStatusBar();\n      if (App.state.total > 0) {\n        toast(toPersianDigits(App.state.total) + ' مجوز یافت شد', 'success', 3000);\n      } else {\n        toast('مجوزی با این فیلتر یافت نشد', 'warning', 3000);\n      }\n    } catch (e) {\n      hideStatusBar();\n      toast(e.message || 'خطا در دریافت اطلاعات', 'danger');\n      if (App.state.view === 'cards' && window.MojavezCards) window.MojavezCards.renderEmpty();\n      else if (window.MojavezTables) window.MojavezTables.renderEmpty();\n    } finally {\n      App.state.loading = false;\n    }\n  }\n\n  /* ---- Load lookups (provinces + organizations) into filter dropdowns ---- */\n  async function loadLookups() {\n    try {\n      const data = await api('GET', '/api/lookups');\n      const lookups = data.data || data;\n      const provSelect = document.getElementById('f-province');\n      const orgSelect = document.getElementById('f-main-org');\n      if (provSelect && lookups.provinces) {\n        lookups.provinces.forEach(function (p) {\n          var opt = document.createElement('option');\n          opt.value = p.id; opt.textContent = p.title;\n          provSelect.appendChild(opt);\n        });\n      }\n      if (orgSelect && lookups.organizations) {\n        lookups.organizations.forEach(function (o) {\n          var opt = document.createElement('option');\n          opt.value = o.id; opt.textContent = o.title;\n          orgSelect.appendChild(opt);\n        });\n      }\n      // Cascade: province → townships, main-org → sub-orgs\n      if (provSelect) {\n        provSelect.addEventListener('change', function () {\n          var pid = provSelect.value;\n          populateTownships(pid);\n        });\n      }\n      if (orgSelect) {\n        orgSelect.addEventListener('change', function () {\n          var oid = orgSelect.value;\n          populateSubOrganizations(oid);\n        });\n      }\n    } catch (e) {\n      // Lookups might be empty if seed_lookups hasn't been run — silent fail\n      console.warn('Lookups load failed:', e.message);\n    }\n  }\n\n  /* ---- Cascade: load townships for a province (with caching) ---- */\n  var _townshipCache = {}; // provinceId -> [{id,title}]\n  async function populateTownships(provinceId) {\n    var sel = document.getElementById('f-township');\n    if (!sel) return;\n    sel.innerHTML = '<option value=\"\">— در حال بارگذاری... —</option>';\n    sel.disabled = true;\n    if (!provinceId) {\n      sel.innerHTML = '<option value=\"\">— ابتدا استان را انتخاب کنید —</option>';\n      return;\n    }\n    try {\n      var list = _townshipCache[provinceId];\n      if (!list) {\n        const data = await api('GET', '/api/lookups/townships/' + encodeURIComponent(provinceId));\n        list = data.data || data || [];\n        _townshipCache[provinceId] = list;\n      }\n      if (!list.length) {\n        sel.innerHTML = '<option value=\"\">— شهرستی یافت نشد —</option>';\n        return;\n      }\n      sel.innerHTML = '<option value=\"\">— همه شهرستان‌ها —</option>';\n      list.forEach(function (t) {\n        var opt = document.createElement('option');\n        opt.value = t.id; opt.textContent = t.title;\n        sel.appendChild(opt);\n      });\n      sel.disabled = false;\n    } catch (e) {\n      sel.innerHTML = '<option value=\"\">— خطا در بارگذاری شهرستان‌ها —</option>';\n      console.warn('Townships load failed:', e.message);\n    }\n  }\n\n  /* ---- Cascade: load sub-organizations for a main org (with caching) ---- */\n  var _subOrgCache = {}; // mainOrgCode -> [{id,title}]\n  async function populateSubOrganizations(orgCode) {\n    var sel = document.getElementById('f-sub-org');\n    if (!sel) return;\n    sel.innerHTML = '<option value=\"\">— در حال بارگذاری... —</option>';\n    sel.disabled = true;\n    if (!orgCode) {\n      sel.innerHTML = '<option value=\"\">— ابتدا دستگاه اصلی را انتخاب کنید —</option>';\n      return;\n    }\n    try {\n      var list = _subOrgCache[orgCode];\n      if (!list) {\n        const data = await api('GET', '/api/lookups/sub-organizations/' + encodeURIComponent(orgCode));\n        list = data.data || data || [];\n        _subOrgCache[orgCode] = list;\n      }\n      if (!list.length) {\n        sel.innerHTML = '<option value=\"\">— زیردستگاهی یافت نشد —</option>';\n        return;\n      }\n      sel.innerHTML = '<option value=\"\">— همه زیردستگاه‌ها —</option>';\n      list.forEach(function (s) {\n        var opt = document.createElement('option');\n        opt.value = s.id; opt.textContent = s.title;\n        sel.appendChild(opt);\n      });\n      sel.disabled = false;\n    } catch (e) {\n      sel.innerHTML = '<option value=\"\">— خطا در بارگذاری زیردستگاه‌ها —</option>';\n      console.warn('Sub-orgs load failed:', e.message);\n    }\n  }\n\n  /* ---- Normalize license fields so both backend and frontend naming work ---- */\n  /* ---- Backend returns: province_title, township_title, organization_title ---- */\n  /* ---- Frontend expects: province, township, organization ---- */\n  function normalizeLicense(item) {\n    if (!item) return item;\n    var status = item.status;\n    var statusSlug = '';\n    var statusLabel = '';\n    if (typeof status === 'object' && status) {\n      statusSlug = status.slug || status.value || '';\n      statusLabel = status.label || status.title || '';\n    } else if (typeof status === 'string') {\n      statusSlug = status;\n    }\n    return {\n      request_number: item.request_number || item.license_number || '',\n      applicant_name: item.applicant_name || item.applicant || '',\n      user_image: item.user_image || item.image || null,\n      license_title: item.license_title || item.title || '',\n      organization: item.organization_title || item.organization || item.issuer || '',\n      province: item.province_title || item.province || '',\n      township: item.township_title || item.town || '',\n      responded_at: item.responded_at || item.issue_date || item.date || '',\n      status: statusSlug,\n      status_label: statusLabel,\n      // Preserve the saved flag from the backend so the bookmark button keeps\n      // its state across re-renders. Without this, every normalizeLicense()\n      // call (which happens on every search/pagination) would drop is_saved\n      // and the button would flip back to \"not saved\" — looking like the save\n      // was immediately undone. This was the \"saved license gets deleted\n      // immediately\" bug.\n      is_saved: item.is_saved === true,\n      _raw: item\n    };\n  }\n\n  function renderCurrentView() {\n    if (App.state.view === 'cards' && window.MojavezCards) {\n      window.MojavezCards.renderCards(App.state.items, document.getElementById('cards-container'));\n      window.MojavezCards.renderCardsPagination(App.state.page, App.state.pageSize, App.state.total);\n    } else if (window.MojavezTables) {\n      window.MojavezTables.renderTable(App.state.items, document.getElementById('table-container'));\n      window.MojavezTables.renderPagination(App.state.page, App.state.pageSize, App.state.total);\n    }\n  }\n\n  function updateCountDisplay() {\n    const el = document.querySelector('.app-main__count');\n    if (el) el.textContent = toPersianDigits(App.state.total) + ' مجوز';\n  }\n\n  /* ---- Pagination handlers ---- */\n  function gotoPage(page) {\n    const totalPages = Math.max(1, Math.ceil(App.state.total / App.state.pageSize));\n    if (page < 1 || page > totalPages) return;\n    App.state.page = page;\n    // If viewing saved licenses, paginate the saved view; otherwise the live search.\n    if (App.state.viewingSaved) refreshSavedView();\n    else refreshCurrentView();\n  }\n\n  function setPageSize(size) {\n    App.state.pageSize = size;\n    App.state.page = 1;\n    try { localStorage.setItem('mojavez_page_size', String(size)); } catch (_) {}\n    refreshCurrentView();\n  }\n\n  /* ---- Export buttons: /api/licenses/export?format=csv|json ---- */\n  async function exportLicenses(format) {\n    try {\n      toast('در حال آماده‌سازی فایل خروجی...', 'info', 3000);\n      const params = { format: format, ...App.state.filters };\n      const url = '/api/licenses/export' + buildQuery(params);\n      const res = await api('GET', url, null, { raw: true });\n      if (!res.ok) throw new Error('خطا در تولید فایل');\n      const blob = await res.blob();\n      const a = document.createElement('a');\n      const ext = format === 'csv' ? 'csv' : 'json';\n      a.href = URL.createObjectURL(blob);\n      a.download = 'mojavez-licenses-' + Date.now() + '.' + ext;\n      document.body.appendChild(a); a.click(); a.remove();\n      URL.revokeObjectURL(a.href);\n      toast('فایل خروجی آماده شد', 'success');\n    } catch (e) {\n      toast(e.message || 'خطا در خروجی گرفتن', 'danger');\n    }\n  }\n\n  /* ---- License detail loader ---- */\n  async function openLicenseDetail(requestNumber) {\n    // Navigate to the standalone license detail page. This gives the user a\n    // shareable URL (/license/{rn}), a full-page layout with QR code, and\n    // the ability to print/bookmark the detail directly.\n    // The modal-based detail is kept as openLicenseDetailModal() for any\n    // future quick-view use cases.\n    if (!requestNumber) return;\n    window.location.href = '/license/' + encodeURIComponent(requestNumber);\n  }\n\n  // Kept for backward compatibility: opens the detail in a modal (quick view).\n  async function openLicenseDetailModal(requestNumber) {\n    try {\n      openModal('<div class=\"spinner-wrap\"><div class=\"spinner\"></div><div>در حال بارگذاری...</div></div>',\n        { title: 'جزئیات مجوز' });\n      // The API returns { ok: true, data: { ...license } }, NOT the license directly.\n      // Previously we passed the whole envelope to renderDetailHtml, which then saw\n      // wrapper.request_number === undefined → rendered everything as '—'.\n      const resp = await api('GET', '/api/licenses/' + encodeURIComponent(requestNumber));\n      const license = (resp && resp.data) ? resp.data : resp; // unwrap envelope\n      const html = window.MojavezCards && window.MojavezCards.renderDetailHtml\n        ? window.MojavezCards.renderDetailHtml(license)\n        : '<pre>' + escapeHtml(JSON.stringify(license, null, 2)) + '</pre>';\n      const body = document.querySelector('.modal__body');\n      if (body) body.innerHTML = html;\n    } catch (e) {\n      const body = document.querySelector('.modal__body');\n      if (body) body.innerHTML = '<p class=\"text-muted\">' + escapeHtml(e.message) + '</p>';\n      toast(e.message || 'خطا در بارگذاری جزئیات', 'danger');\n    }\n  }\n\n  /* ---- Sidebar toggle (mobile) ---- */\n  function toggleSidebar() {\n    const sidebar = document.querySelector('.app-sidebar');\n    const backdrop = document.querySelector('.app-backdrop');\n    const toggleBtn = document.querySelector('[data-action=\"toggle-sidebar\"]');\n    if (!sidebar) return;\n    const open = sidebar.classList.toggle('is-open');\n    if (backdrop) backdrop.classList.toggle('is-visible', open);\n    // a11y: reflect expanded state to the toggle button (aria-controls already\n    // points to #sidebar so screen readers know what this controls).\n    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');\n  }\n\n  /* ---- Save / unsave a single license (bookmark) ---- */\n  /* ---- POST /api/licenses/{rn}/save  (mark saved)              ---- */\n  /* ---- DELETE /api/licenses/{rn}/save (unmark)                  ---- */\n  /* ---- The button toggles its visual state based on data-saved. ---- */\n  // Per-request-number in-flight lock: prevents a second click on the SAME\n  // license (rapid double-click, or a stray duplicated click event) from\n  // firing a second POST/DELETE while the first one is still pending. Without\n  // this, a fast double-click could land as POST then DELETE in quick\n  // succession — leaving the license in the opposite of the intended state.\n  var _saveInFlight = {};\n  async function toggleSaveLicense(rn, btnEl) {\n    if (!rn) return;\n    if (_saveInFlight[rn]) return; // a request for this license is already in flight\n    _saveInFlight[rn] = true;\n    try {\n      await _toggleSaveLicenseImpl(rn, btnEl);\n    } finally {\n      delete _saveInFlight[rn];\n    }\n  }\n  async function _toggleSaveLicenseImpl(rn, btnEl) {\n    const currentlySaved = btnEl.dataset.saved === '1';\n    const method = currentlySaved ? 'DELETE' : 'POST';\n    const url = '/api/licenses/' + encodeURIComponent(rn) + '/save';\n    // Optimistic UI: flip the button state immediately so the UI feels instant;\n    // revert if the API call fails.\n    btnEl.dataset.saved = currentlySaved ? '0' : '1';\n    btnEl.classList.toggle('is-saved', !currentlySaved);\n    btnEl.title = currentlySaved ? 'ذخیره این مجوز' : 'حذف از ذخیره‌شده‌ها';\n    btnEl.innerHTML = currentlySaved ? '☆ ذخیره' : '★ ذخیره شد';\n    // Disable the button while the request is in flight so the user can't\n    // click it again (visual feedback + extra defense on top of the in-flight\n    // lock above).\n    btnEl.disabled = true;\n    // Keep App.state.items in sync so re-rendering preserves the saved state.\n    const item = App.state.items.find((it) => (it.request_number || it.license_number) === rn);\n    if (item) item.is_saved = !currentlySaved;\n    try {\n      await api(method, url);\n      toast(currentlySaved ? 'از ذخیره‌شده‌ها حذف شد' : 'مجوز ذخیره شد', 'success', 2000);\n    } catch (e) {\n      // Revert on failure.\n      btnEl.dataset.saved = currentlySaved ? '1' : '0';\n      btnEl.classList.toggle('is-saved', currentlySaved);\n      btnEl.title = currentlySaved ? 'حذف از ذخیره‌شده‌ها' : 'ذخیره این مجوز';\n      btnEl.innerHTML = currentlySaved ? '★ ذخیره شد' : '☆ ذخیره';\n      if (item) item.is_saved = currentlySaved;\n      toast(e.message || 'خطا در ذخیره‌سازی', 'danger');\n    } finally {\n      btnEl.disabled = false;\n    }\n  }\n\n  /* ---- Save ALL licenses matching the current filter (bookmark them in bulk) ---- */\n  /* ---- POST /api/licenses/save-all with the current filter as the body.        ---- */\n  /* ---- The backend walks ALL upstream pages for this filter, persists every    ---- */\n  /* ---- item to the local cache, then marks the full set as is_saved=1.         ---- */\n  /* ---- This can take several seconds for large result sets (one HTTP request    ---- */\n  /* ---- per upstream page). A status bar keeps the user informed.                ---- */\n  var _saveAllInFlight = false;\n  async function saveAllCurrent() {\n    if (App.state.total === 0) {\n      toast('مجوزی برای ذخیره وجود ندارد', 'warning');\n      return;\n    }\n    if (_saveAllInFlight) return; // already saving — ignore the second click\n    // Confirm against the upstream total the user saw in the search results.\n    if (!confirm('همه ' + toPersianDigits(App.state.total) + ' مجوزِ این جستجو ذخیره شوند؟ این عملیات ممکن است چند ثانیه طول بکشد.')) return;\n    _saveAllInFlight = true;\n    try {\n      showStatusBar('در حال دریافت و ذخیره‌سازی همه‌ی مجوزها از درگاه ملی...');\n      const resp = await api('POST', '/api/licenses/save-all', App.state.filters);\n      const d = (resp && resp.data) ? resp.data : resp;\n      const saved = d.saved_count || 0;\n      const fetched = d.fetched_count || 0;\n      const total = d.total || saved;\n      hideStatusBar();\n      var msg = toPersianDigits(saved) + ' مجوز ذخیره شد';\n      if (fetched && fetched !== saved) {\n        msg += ' (از مجموع ' + toPersianDigits(total) + ' مجوز یافت‌شده)';\n      }\n      toast(msg, 'success', 4000);\n      // Refresh the current view so all cards show the saved state.\n      refreshCurrentView();\n    } catch (e) {\n      hideStatusBar();\n      toast(e.message || 'خطا در ذخیره‌سازی همه', 'danger');\n    } finally {\n      _saveAllInFlight = false;\n    }\n  }\n\n  /* ---- View only saved licenses (is_saved = 1) ---- */\n  /* ---- Sets a flag so the next search uses saved_only=1, then ---- */\n  /* ---- queries the local cache directly (no upstream call).   ---- */\n  function viewSaved() {\n    App.state.viewingSaved = true;\n    App.state.page = 1;\n    refreshSavedView();\n    // Update the toolbar toggle state.\n    document.querySelectorAll('[data-action=\"view-saved\"]').forEach((el) => {\n      el.classList.add('is-active');\n    });\n    document.querySelectorAll('[data-action=\"view-all\"]').forEach((el) => {\n      el.classList.remove('is-active');\n    });\n  }\n\n  /* ---- Return to normal search view (clear the saved filter) ---- */\n  function viewAll() {\n    App.state.viewingSaved = false;\n    refreshCurrentView();\n    document.querySelectorAll('[data-action=\"view-saved\"]').forEach((el) => {\n      el.classList.remove('is-active');\n    });\n    document.querySelectorAll('[data-action=\"view-all\"]').forEach((el) => {\n      el.classList.add('is-active');\n    });\n  }\n\n  /* ---- Fetch the saved-only view from the local cache (GET /api/licenses?saved_only=1) ---- */\n  async function refreshSavedView() {\n    App.state.loading = true;\n    // Build the query: saved_only=1 ONLY — do NOT carry the user's current\n    // search filters here. The \"saved\" view should show EVERY license the user\n    // has ever bookmarked, regardless of the filter that's currently in the\n    // search form. Previously we spread App.state.filters in, which meant:\n    // save licenses from search A → change filter to search B → click \"saved\" →\n    // see only saved licenses that ALSO match filter B (i.e. the A-licenses\n    // seemed to disappear, looking like \"saved data gets replaced\"). Dropping\n    // the filter here makes the saved view show all saved licenses, accumulated.\n    const params = { saved_only: 1, page: App.state.page, page_size: App.state.pageSize };\n    const url = '/api/licenses' + buildQuery(params);\n    if (App.state.view === 'cards' && window.MozavezCards) window.MozavezCards.renderLoading();\n    else if (window.MozavezTables) window.MozavezTables.renderLoading();\n    try {\n      showStatusBar('در حال بارگذاری مجوزهای ذخیره‌شده...');\n      const data = await api('GET', url);\n      App.state.items = (data.data || data.items || []).map(normalizeLicense);\n      App.state.total = data.total || App.state.items.length;\n      renderCurrentView();\n      updateCountDisplay();\n      hideStatusBar();\n      if (App.state.total > 0) {\n        toast(toPersianDigits(App.state.total) + ' مجوز ذخیره‌شده', 'info', 2500);\n      } else {\n        toast('هنوز مجوزی ذخیره نکرده‌اید', 'warning', 2500);\n      }\n    } catch (e) {\n      hideStatusBar();\n      toast(e.message || 'خطا در بارگذاری ذخیره‌شده‌ها', 'danger');\n    } finally {\n      App.state.loading = false;\n    }\n  }\n\n  /* ---- Event delegation setup ---- */\n  function setupDelegation() {\n    document.addEventListener('click', (e) => {\n      const target = e.target.closest('[data-action]');\n      if (!target) return;\n      switch (target.dataset.action) {\n        case 'toggle-sidebar': toggleSidebar(); break;\n        case 'view-cards': setView('cards'); break;\n        case 'view-table': setView('table'); break;\n        case 'export-csv': exportLicenses('csv'); break;\n        case 'export-json': exportLicenses('json'); break;\n        case 'close-modal': closeModal(); break;\n        case 'goto-page': { const p = +target.dataset.page; if (p) gotoPage(p); break; }\n        case 'open-license': {\n          const rn = target.dataset.requestNumber;\n          if (rn) openLicenseDetail(rn);\n          break;\n        }\n        case 'toggle-save': {\n          const rn = target.dataset.requestNumber;\n          if (rn) toggleSaveLicense(rn, target);\n          break;\n        }\n        case 'save-all': saveAllCurrent(); break;\n        case 'view-saved': viewSaved(); break;\n        case 'view-all': viewAll(); break;\n      }\n    });\n    document.addEventListener('submit', (e) => {\n      const form = e.target.closest('[data-form]');\n      if (!form) return;\n      e.preventDefault();\n      if (form.dataset.form === 'filters') handleFilterSubmit(form);\n    });\n    document.addEventListener('change', (e) => {\n      if (e.target.matches('[data-page-size]')) setPageSize(+e.target.value);\n    });\n    // Reset cascade dropdowns when the filter form is reset.\n    document.addEventListener('reset', (e) => {\n      const form = e.target.closest('[data-form=\"filters\"]');\n      if (!form) return;\n      // Defer until after the browser actually clears the selects.\n      setTimeout(function () {\n        var ts = document.getElementById('f-township');\n        if (ts) {\n          ts.innerHTML = '<option value=\"\">— ابتدا استان را انتخاب کنید —</option>';\n          ts.disabled = true;\n        }\n        var so = document.getElementById('f-sub-org');\n        if (so) {\n          so.innerHTML = '<option value=\"\">— ابتدا دستگاه اصلی را انتخاب کنید —</option>';\n          so.disabled = true;\n        }\n      }, 0);\n    });\n    // View toggle buttons (data-view attribute)\n    document.querySelectorAll('.view-toggle__btn').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var v = btn.dataset.view;\n        if (v) setView(v);\n      });\n    });\n  }\n\n  /* ---- Initialize on DOMContentLoaded ---- */\n  // init() may be called more than once — the app.js IIFE auto-binds it on\n  // DOMContentLoaded, AND HomeController's inline <script> calls MojavezApp.init()\n  // on DOMContentLoaded too. Without a guard, setupDelegation() would run twice\n  // and register TWO click listeners on document, so EVERY click fired twice.\n  // That was the root cause of the \"save a license → it gets deleted\" bug:\n  // listener 1 read saved=0 → flipped the button optimistically → fired POST.\n  // listener 2 then read saved=1 (the optimistic flip) → fired DELETE.\n  // The guard makes init() idempotent.\n  var _appInitialized = false;\n  function init() {\n    if (_appInitialized) return;\n    _appInitialized = true;\n    detectCsrfToken();\n    loadSavedView();\n    setView(App.state.view);\n    const savedSize = (() => {\n      try { return parseInt(localStorage.getItem('mojavez_page_size'), 10); } catch (_) { return 0; }\n    })();\n    if (savedSize) App.state.pageSize = savedSize;\n    setupDelegation();\n    const navToggle = document.querySelector('[data-action=\"toggle-sidebar\"]');\n    if (navToggle) navToggle.addEventListener('click', toggleSidebar);\n    const backdrop = document.querySelector('.app-backdrop');\n    if (backdrop) backdrop.addEventListener('click', toggleSidebar);\n    // Don't auto-search on page load — wait for user to submit the filter form.\n    // The HTML already shows a welcome message in the cards container.\n  }\n\n  /* ---- Expose public API ---- */\n  window.MojavezApp = {\n    state: App.state, config: App.config,\n    api, escapeHtml, toast, openModal, closeModal,\n    toJalaliDate, toPersianDigits, buildQuery,\n    showStatusBar, hideStatusBar, setView,\n    refreshCurrentView, gotoPage, setPageSize,\n    exportLicenses, openLicenseDetail, loadLookups, init\n  };\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n"
