            "mimeType": "text/css",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway — Table View Styles\n   Direction (ECC): dense, scannable data table. Sticky first column\n   (license number), zebra rows for readability, hover highlight,\n   clear sortable headers, accessible focus states.\n   Tokens live in tokens.css.\n   ============================================ */\n\n/* ---- Table wrapper + scroll ---- */\n.table-wrapper {\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-lg);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.table-scroll {\n  overflow-x: auto;\n  overflow-y: visible;\n  max-height: calc(100vh - 280px);\n  -webkit-overflow-scrolling: touch;\n}\n\n/* ---- Filter bar above table ---- */\n.table-filter-bar {\n  display: flex;\n  align-items: center;\n  gap: var(--sp-3);\n  padding: var(--sp-3) var(--sp-4);\n  border-bottom: 1px solid var(--c-border);\n  background: var(--c-surface);\n  flex-wrap: wrap;\n}\n\n.table-filter-bar__search {\n  flex: 1;\n  min-width: 180px;\n  position: relative;\n}\n\n.table-filter-bar__search input {\n  padding-right: 32px;\n}\n\n.table-filter-bar__search::before {\n  content: '';\n  position: absolute;\n  right: var(--sp-3);\n  top: 50%;\n  transform: translateY(-50%);\n  width: 14px;\n  height: 14px;\n  border: 2px solid var(--c-text-subtle);\n  border-radius: 50%;\n}\n\n.table-filter-bar__select {\n  min-width: 130px;\n  max-width: 180px;\n}\n\n.table-filter-bar__actions {\n  display: flex;\n  gap: var(--sp-1);\n  margin-right: auto;\n}\n\n/* ---- Table itself ---- */\n.license-table {\n  width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n  font-size: var(--fs-sm);\n  min-width: 880px;\n}\n\n.license-table thead th {\n  position: sticky;\n  top: 0;\n  z-index: 5;\n  background: var(--c-surface);\n  color: var(--c-text-muted);\n  font-weight: var(--fw-semibold);\n  text-align: right;\n  padding: var(--sp-3) var(--sp-3);\n  border-bottom: 2px solid var(--c-border);\n  white-space: nowrap;\n  user-select: none;\n  font-size: var(--fs-xs);\n  text-transform: none;\n  letter-spacing: 0.01em;\n}\n\n/* Sticky first column (license number) */\n.license-table thead th:nth-child(1),\n.license-table tbody td:nth-child(1) {\n  position: sticky;\n  right: 0;\n  z-index: 4;\n  background: var(--c-surface);\n  border-left: 1px solid var(--c-border-subtle);\n  min-width: 110px;\n  font-weight: var(--fw-semibold);\n}\n\n.license-table thead th:nth-child(1) {\n  z-index: 6;\n}\n\n/* ---- Sortable headers ---- */\n.license-table th.is-sortable {\n  cursor: pointer;\n  transition: color var(--t-base);\n}\n\n.license-table th.is-sortable:hover {\n  color: var(--c-primary);\n}\n\n.license-table th .sort-indicator {\n  display: inline-block;\n  margin-right: var(--sp-1);\n  font-size: var(--fs-xs);\n  color: var(--c-text-muted);\n  opacity: 0.5;\n}\n\n.license-table th.is-asc .sort-indicator::after { content: '\\25B2'; }\n.license-table th.is-desc .sort-indicator::after { content: '\\25BC'; }\n\n.license-table th.is-asc,\n.license-table th.is-desc {\n  color: var(--c-primary);\n}\n\n.license-table th.is-asc .sort-indicator,\n.license-table th.is-desc .sort-indicator {\n  opacity: 1;\n  color: var(--c-primary);\n}\n\n/* ---- Body cells ---- */\n.license-table tbody td {\n  padding: var(--sp-2) var(--sp-3);\n  border-bottom: 1px solid var(--c-border-subtle);\n  color: var(--c-text);\n  vertical-align: middle;\n}\n\n.license-table tbody td.is-clickable {\n  cursor: pointer;\n}\n\n/* ---- Striped / zebra rows ---- */\n.license-table tbody tr:nth-child(even) td {\n  background: var(--c-bg);\n}\n\n/* ---- Hover row highlight ---- */\n.license-table tbody tr:hover td {\n  background: var(--c-primary-soft);\n}\n\n/* First column sticky override on hover/zebra */\n.license-table tbody tr:nth-child(even) td:nth-child(1) {\n  background: var(--c-bg);\n}\n\n.license-table tbody tr:hover td:nth-child(1) {\n  background: var(--c-primary-soft);\n}\n\n/* ---- Cell clamps ---- */\n.license-table .cell-clamp-2 {\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  max-width: 240px;\n}\n\n/* ---- Status cell ---- */\n.table-status {\n  display: inline-block;\n  padding: 2px var(--sp-2);\n  border-radius: var(--r-pill);\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-semibold);\n  white-space: nowrap;\n}\n\n.table-status--active   { background: var(--c-success-soft); color: var(--c-success); }\n.table-status--expired  { background: var(--c-danger-soft);  color: var(--c-danger); }\n.table-status--unknown  { background: var(--c-surface-sunken); color: var(--c-text-muted); }\n\n/* ---- Row actions ---- */\n.table-action {\n  background: transparent;\n  border: 1px solid var(--c-border);\n  color: var(--c-text-muted);\n  padding: var(--sp-1) var(--sp-3);\n  border-radius: var(--r-sm);\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-medium);\n  margin-left: var(--sp-1);\n  min-height: 28px;\n  transition: border-color var(--t-base), color var(--t-base);\n}\n\n.table-action:hover {\n  border-color: var(--c-primary);\n  color: var(--c-primary);\n}\n\n/* ---- Empty state row ---- */\n.license-table .table-empty td {\n  text-align: center;\n  padding: var(--sp-12) var(--sp-5);\n  color: var(--c-text-muted);\n}\n\n.table-empty__title {\n  font-size: var(--fs-md);\n  font-weight: var(--fw-semibold);\n  color: var(--c-text);\n  margin-bottom: var(--sp-1);\n}\n\n.table-empty__text {\n  font-size: var(--fs-sm);\n}\n\n/* ---- Density modes ---- */\n.table-wrapper.is-compact .license-table tbody td,\n.table-wrapper.is-compact .license-table thead th {\n  padding: var(--sp-1) var(--sp-3);\n  font-size: var(--fs-xs);\n}\n\n.table-wrapper.is-compact .license-table {\n  min-width: 760px;\n}\n\n/* ---- Pagination controls bar ---- */\n.table-pagination {\n  display: flex;\n  align-items: center;\n  gap: var(--sp-3);\n  padding: var(--sp-3) var(--sp-4);\n  border-top: 1px solid var(--c-border);\n  background: var(--c-surface);\n  flex-wrap: wrap;\n}\n\n.table-pagination__info {\n  color: var(--c-text-muted);\n  font-size: var(--fs-xs);\n  margin-right: auto;\n}\n\n.table-pagination__pages {\n  display: flex;\n  gap: var(--sp-1);\n  list-style: none;\n}\n\n.page-btn {\n  min-width: 32px;\n  height: 32px;\n  padding: 0 var(--sp-2);\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-sm);\n  color: var(--c-text);\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-medium);\n  transition: background var(--t-base), border-color var(--t-base);\n}\n\n.page-btn:hover:not(:disabled) {\n  border-color: var(--c-primary);\n  color: var(--c-primary);\n}\n\n.page-btn.is-active {\n  background: var(--c-primary);\n  border-color: var(--c-primary);\n  color: var(--c-text-on-primary);\n}\n\n.page-btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.page-btn--ellipsis {\n  border: none;\n  background: transparent;\n  cursor: default;\n}\n\n.page-size-select {\n  padding: var(--sp-1) var(--sp-2);\n  font-size: var(--fs-xs);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-sm);\n  background: var(--c-surface);\n  color: var(--c-text);\n  min-height: 32px;\n}\n\n/* ---- Mobile adjustments ---- */\n@media (max-width: 768px) {\n  .table-filter-bar {\n    padding: var(--sp-3);\n  }\n\n  .table-filter-bar__actions {\n    width: 100%;\n    margin-right: 0;\n  }\n\n  .table-pagination {\n    flex-direction: column;\n    align-items: stretch;\n    gap: var(--sp-2);\n  }\n\n  .table-pagination__info {\n    margin-right: 0;\n    text-align: center;\n  }\n\n  .table-pagination__pages {\n    justify-content: center;\n    flex-wrap: wrap;\n  }\n}\n"
          },
