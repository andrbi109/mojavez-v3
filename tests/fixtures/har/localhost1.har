          "content": {
            "size": 13619,
            "mimeType": "application/javascript",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway - License Detail Page Logic\n   Reads window.__LICENSE__ (server-injected) and renders\n   the detail view: identity, status, QR, metadata, save/print/copy.\n   ============================================ */\n\n(function () {\n  'use strict';\n\n  const Detail = {};\n\n  /* ---- Helpers ---- */\n  function esc(str) {\n    return window.MojavezApp ? window.MojavezApp.escapeHtml(str) : String(str || '');\n  }\n  function toFaDigitsStr(s) {\n    return window.MojavezApp ? window.MojavezApp.toPersianDigits(String(s)) : String(s);\n  }\n  function jalali(input) {\n    return window.MojavezApp ? window.MojavezApp.toJalaliDate(input) : (input || '');\n  }\n  function api(method, url, body) {\n    return window.MojavezApp ? window.MojavezApp.api(method, url, body) : fetch(url).then(r => r.json());\n  }\n  function toast(msg, type) {\n    if (window.MojavezApp && window.MojavezApp.toast) window.MojavezApp.toast(msg, type);\n  }\n  function setText(id, val) {\n    const el = document.getElementById(id);\n    if (el) el.textContent = val;\n  }\n  function setHtml(id, html) {\n    const el = document.getElementById(id);\n    if (el) el.innerHTML = html;\n  }\n  // The upstream image host for applicant photos. The search API returns a\n  // RELATIVE path (\"profile-pictures/xx/yyy.png\"); when the user is viewing\n  // /license/{rn}, the browser resolves that against /license/, producing\n  // /license/profile-pictures/... (404). We absolutize against the real host.\n  // (Verified against the live site: https://mojavez.ir/profile-pictures/...)\n  const UPSTREAM_HOST = 'https://mojavez.ir';\n  function absolutizeImage(img) {\n    if (!img) return null;\n    if (/^https?:\\/\\//i.test(img) || img.startsWith('data:')) return img;\n    // Normalize leading slashes: host + '/' + path-without-leading-slash\n    return UPSTREAM_HOST + '/' + String(img).replace(/^\\/+/, '');\n  }\n  function orDash(v) {\n    const s = (v === null || v === undefined) ? '' : String(v).trim();\n    return s === '' ? '—' : s;\n  }\n\n  /* ---- Status mapping ---- */\n  function statusInfo(license) {\n    let slug = '', label = '';\n    if (license && typeof license.status === 'object' && license.status) {\n      slug = (license.status.slug || license.status.value || '').toString().toLowerCase();\n      label = license.status.label || license.status.title || '';\n    } else if (license && license.status) {\n      slug = String(license.status).toLowerCase();\n      label = license.status_label || '';\n    }\n    if (slug === 'active' || slug === 'valid' || slug === '1' || slug === 'true') {\n      return { label: label || 'معتبر', cls: 'is-active' };\n    }\n    if (slug === 'expired' || slug === 'inactive' || slug === '0') {\n      return { label: label || 'منقضی', cls: 'is-expired' };\n    }\n    return { label: label || 'نامشخص', cls: '' };\n  }\n\n  /* ---- Render the detail page from window.__LICENSE__ ---- */\n  function render() {\n    const license = window.__LICENSE__;\n    if (!license) {\n      setHtml('detail-title', '<span class=\"text-muted\">مجوز یافت نشد</span>');\n      return;\n    }\n\n    const rn = license.request_number || license.requestNumber || '—';\n    const title = license.license_title || license.licenseTitle || 'مجوز بدون عنوان';\n    const applicant = license.applicant_name || license.applicantName || '—';\n    const org = license.organization_title || license.organizationTitle || license.organization || '—';\n    const province = license.province_title || license.provinceTitle || license.province || '—';\n    const township = license.township_title || license.townshipTitle || license.township || '—';\n    const date = license.responded_at || license.respondedAt || '';\n    const st = statusInfo(license);\n\n    // Header title\n    setText('detail-title', title);\n\n    // Identity card\n    const avatarEl = document.getElementById('detail-avatar');\n    if (avatarEl) {\n      const initials = (applicant && applicant.trim())\n        ? applicant.trim().charAt(0)\n        : '؟';\n      const imgUrl = absolutizeImage(license.user_image || license.userImage || null);\n      if (imgUrl) {\n        // onerror hides the broken img so the initials placeholder stays clean\n        avatarEl.innerHTML = '<img src=\"' + esc(imgUrl) + '\" alt=\"تصویر متقاضی\" '\n          + 'onerror=\"this.style.display=\\'none\\';this.parentNode.textContent=\\'' + initials.replace(/'/g, '') + '\\'\">';\n      } else {\n        avatarEl.textContent = initials;\n      }\n    }\n    setText('detail-applicant', applicant);\n    setText('detail-organization', org);\n\n    // Status pill\n    const statusEl = document.getElementById('detail-status');\n    if (statusEl) {\n      statusEl.textContent = st.label;\n      statusEl.className = 'detail-status ' + st.cls;\n    }\n    setText('detail-status-value', st.label);\n\n    // Metadata (basic — already known from search results)\n    setText('detail-rn', toFaDigitsStr(rn));\n    setText('detail-license-title', title);\n    setText('detail-province', province);\n    setText('detail-township', township);\n    setText('detail-org', org);\n    setText('detail-date', date ? jalali(date) : '—');\n    setText('detail-uid', toFaDigitsStr(rn));\n\n    // Save button initial state\n    const saveBtn = document.getElementById('detail-save');\n    if (saveBtn) {\n      const saved = !!(license.is_saved || license.isSaved);\n      saveBtn.dataset.saved = saved ? '1' : '0';\n      saveBtn.textContent = saved ? '★ ذخیره شد' : '☆ ذخیره';\n    }\n\n    // Generate QR code\n    generateQR(rn);\n\n    // Document title\n    document.title = title + ' — درگاه اختصاصی مجوزها';\n\n    // Fetch extended track data (father name, national ID, ISIC, etc.) from\n    // the gateway proxy which scrapes the upstream track page. This populates\n    // the \"مشخصات متقاضی\" extended fields, \"اطلاعات کامل مجوز\", \"اطلاعات محل\n    // کسب و کار\", and \"سوابق کسب و کار\" sections.\n    loadTrackData(rn);\n  }\n\n  /* ---- Load extended detail from the upstream track page (via proxy) ---- */\n  async function loadTrackData(rn) {\n    try {\n      // The backend scrapes the upstream track page synchronously, which can\n      // take several seconds on a slow connection. Give it up to 45s.\n      const resp = await api('GET', '/api/licenses/' + encodeURIComponent(rn) + '/track', null, { timeout: 45000 });\n      const d = (resp && resp.data) ? resp.data : resp;\n      if (!d || d.found === false) {\n        // Upstream track page not reachable / no data — leave the \"—\" placeholders\n        // the server already rendered; surface a soft note in the history section.\n        const hist = document.getElementById('detail-history');\n        if (hist) hist.innerHTML = '<p class=\"text-muted\" style=\"font-size:var(--fs-sm);\">داده‌ی تفصیلی از درگاه ملی در دسترس نیست.</p>';\n        return;\n      }\n      // مشخصات متقاضی (extended)\n      setText('detail-father', toFaDigitsStr(orDash(d.father_name)));\n      setText('detail-national-id', toFaDigitsStr(orDash(d.national_id)));\n      setText('detail-mobile', toFaDigitsStr(orDash(d.mobile)));\n      // اطلاعات کامل مجوز (extended)\n      setText('detail-issuing-authority', orDash(d.issuing_authority));\n      setText('detail-supervisors', orDash(d.supervisory_authorities));\n      setText('detail-tracking-code', toFaDigitsStr(orDash(d.tracking_code)));\n      setText('detail-isic-code', toFaDigitsStr(orDash(d.isic_code)));\n      setText('detail-isic-title', orDash(d.isic_title));\n      setText('detail-issuance-type', orDash(d.issuance_type));\n      setText('detail-issue-date', d.issue_date ? jalali(d.issue_date) : '—');\n      setText('detail-expiry-date', d.expiry_date ? jalali(d.expiry_date) : '—');\n      // اطلاعات محل کسب و کار\n      setText('detail-business-province', orDash(d.business_province));\n      setText('detail-business-township', orDash(d.business_township));\n      setText('detail-postal-code', toFaDigitsStr(orDash(d.postal_code)));\n      setText('detail-business-address', orDash(d.business_address));\n      // سوابق کسب و کار\n      renderBusinessHistory(d.business_history || []);\n    } catch (e) {\n      const hist = document.getElementById('detail-history');\n      if (hist) hist.innerHTML = '<p class=\"text-muted\" style=\"font-size:var(--fs-sm);\">دریافت داده‌ی تفصیلی ناموفق بود: ' + esc(e.message || 'خطا') + '</p>';\n    }\n  }\n\n  /* ---- Render business history table ---- */\n  function renderBusinessHistory(rows) {\n    const wrap = document.getElementById('detail-history');\n    if (!wrap) return;\n    if (!rows || rows.length === 0) {\n      wrap.innerHTML = '<p class=\"text-muted\" style=\"font-size:var(--fs-sm);\">سابقه‌ای ثبت نشده است.</p>';\n      return;\n    }\n    // Columns match the upstream track page exactly: ردیف / عملیات / دلایل / تاریخ.\n    // (The upstream \"تاریخ\" is a Jalali date string like \"1405-08-17\", so we\n    // only Persian-digitize it rather than re-convert.)\n    let html = '<table class=\"detail-history__table\"><thead><tr>'\n      + '<th>ردیف</th><th>عملیات</th><th>دلایل</th><th>تاریخ</th>'\n      + '</tr></thead><tbody>';\n    rows.forEach(function (r) {\n      html += '<tr>'\n        + '<td>' + esc(r.index || '—') + '</td>'\n        + '<td>' + esc(r.operation || r.title || '—') + '</td>'\n        + '<td>' + esc(r.reasons || '—') + '</td>'\n        + '<td>' + esc(r.date ? toFaDigitsStr(r.date) : '—') + '</td>'\n        + '</tr>';\n    });\n    html += '</tbody></table>';\n    wrap.innerHTML = html;\n  }\n\n  /* ---- QR generation (uses qr-generator vendor loaded globally) ---- */\n  function generateQR(rn) {\n    const qrEl = document.getElementById('detail-qr');\n    const hintEl = document.getElementById('detail-qr-hint');\n    if (!qrEl) return;\n\n    // The upstream tracking URL pattern (scanning opens the official page).\n    const trackUrl = 'https://qr.mojavez.ir/track/' + encodeURIComponent(rn);\n\n    // The correct API is window.MojavezQR.render() (exposed by qr-generator.js,\n    // which is loaded globally before this file). The old code called\n    // window.MojavezApp.qrGenerate which never existed → \"مولد QR در دسترس نیست\".\n    try {\n      if (window.MojavezQR && typeof window.MojavezQR.render === 'function') {\n        const svg = window.MojavezQR.render(trackUrl, {\n          size: 220, margin: 4, dark: '#1e293b', light: '#ffffff', level: 'M'\n        });\n        qrEl.innerHTML = svg || '';\n        if (hintEl) {\n          hintEl.innerHTML = 'اسکن کنید تا صفحه‌ی رهگیری در درگاه ملی باز شود.<br>'\n            + '<a href=\"' + esc(trackUrl) + '\" target=\"_blank\" rel=\"noopener\">باز کردن پیوند رهگیری ↗</a>';\n        }\n        return;\n      }\n      // Vendor library missing — show a clear link fallback.\n      qrEl.innerHTML = '<a href=\"' + esc(trackUrl) + '\" target=\"_blank\" rel=\"noopener\" '\n        + 'style=\"font-size:var(--fs-sm);color:var(--c-primary);\">'\n        + esc(trackUrl) + '</a>';\n      if (hintEl) hintEl.textContent = 'کتابخانه‌ی تولید QR بارگذاری نشده است.';\n    } catch (e) {\n      console.warn('QR generation failed', e);\n      qrEl.innerHTML = '<a href=\"' + esc(trackUrl) + '\" target=\"_blank\" rel=\"noopener\" '\n        + 'style=\"font-size:var(--fs-sm);color:var(--c-primary);\">'\n        + esc(trackUrl) + '</a>';\n      if (hintEl) hintEl.textContent = 'خطا در تولید QR.';\n    }\n  }\n\n  /* ---- Save / unsave toggle ---- */\n  async function toggleSave() {\n    const license = window.__LICENSE__;\n    if (!license) return;\n    const rn = license.request_number || license.requestNumber;\n    if (!rn) return;\n    const btn = document.getElementById('detail-save');\n    if (!btn) return;\n    const isSaved = btn.dataset.saved === '1';\n    const method = isSaved ? 'DELETE' : 'POST';\n    try {\n      btn.disabled = true;\n      const resp = await api(method, '/api/licenses/' + encodeURIComponent(rn) + '/save');\n      const nowSaved = !isSaved;\n      btn.dataset.saved = nowSaved ? '1' : '0';\n      btn.textContent = nowSaved ? '★ ذخیره شد' : '☆ ذخیره';\n      toast(nowSaved ? 'مجوز ذخیره شد' : 'ذخیره‌ی مجوز لغو شد', nowSaved ? 'success' : 'info');\n    } catch (e) {\n      toast('خطا در تغییر وضعیت ذخیره', 'danger');\n    } finally {\n      btn.disabled = false;\n    }\n  }\n\n  /* ---- Copy request number ---- */\n  async function copyRN() {\n    const license = window.__LICENSE__;\n    if (!license) return;\n    const rn = license.request_number || license.requestNumber;\n    if (!rn) return;\n    try {\n      await navigator.clipboard.writeText(String(rn));\n      toast('شماره مجوز کپی شد: ' + toFaDigitsStr(rn), 'success', 2000);\n    } catch (e) {\n      toast('کپی ناموفق بود', 'danger');\n    }\n  }\n\n  /* ---- Init ---- */\n  function init() {\n    render();\n    const saveBtn = document.getElementById('detail-save');\n    if (saveBtn) saveBtn.addEventListener('click', toggleSave);\n    const printBtn = document.getElementById('detail-print');\n    if (printBtn) printBtn.addEventListener('click', () => window.print());\n    const copyBtn = document.getElementById('detail-copy');\n    if (copyBtn) copyBtn.addEventListener('click', copyRN);\n  }\n\n  Detail.init = init;\n  Detail.render = render;\n  window.MojavezLicenseDetail = Detail;\n})();\n"
          },
