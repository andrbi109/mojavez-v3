            "mimeType": "application/javascript",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway - Table View Rendering\n   Sortable, filterable, paginated license table\n   ============================================ */\n\n(function () {\n  'use strict';\n\n  const Tables = {};\n\n  /* ---- Column definitions (Persian headers) ---- */\n  const COLUMNS = [\n    { key: 'request_number', label: 'شماره مجوز', sortable: true, sticky: true },\n    { key: 'license_title',  label: 'عنوان',      sortable: true, clamp: 2 },\n    { key: 'applicant_name', label: 'نام متقاضی', sortable: true, clamp: 2 },\n    { key: 'organization',   label: 'صادرکننده',  sortable: true, clamp: 2, alt: 'organization_title' },\n    { key: 'province',       label: 'استان',      sortable: true, alt: 'province_title' },\n    { key: 'township',       label: 'شهرستان',    sortable: true, alt: 'township_title' },\n    { key: 'responded_at',   label: 'تاریخ',      sortable: true, type: 'date' },\n    { key: 'status',         label: 'وضعیت',      sortable: true, type: 'status' },\n    { key: 'actions',        label: 'عملیات',     sortable: false }\n  ];\n\n  /* ---- Helpers from app.js ---- */\n  function esc(str) {\n    return window.MojavezApp ? window.MojavezApp.escapeHtml(str) : String(str || '');\n  }\n  function jalali(input) {\n    return window.MojavezApp ? window.MojavezApp.toJalaliDate(input) : (input || '');\n  }\n  function toFa(n) {\n    return window.MojavezApp ? window.MojavezApp.toPersianDigits(n) : String(n);\n  }\n  function getCell(license, col) {\n    if (col.key === 'actions') return ''; // built separately\n    let val = license[col.key];\n    if (val === undefined) val = license[col.alt] || '';\n    if (col.type === 'date') return jalali(val);\n    return val;\n  }\n\n  /* ---- Status badge cell ---- */\n  function statusCell(license) {\n    // Accept both normalized (status is a string slug) and raw API shape\n    // (status is an object {slug, title, label}).\n    let slug = '', label = '';\n    if (typeof license.status === 'object' && license.status) {\n      slug = (license.status.slug || '').toString().toLowerCase();\n      label = license.status.label || license.status.title || '';\n    } else if (license.status) {\n      slug = String(license.status).toLowerCase();\n      label = license.status_label || '';\n    }\n    let cls;\n    if (slug === 'active' || slug === 'valid' || slug === '1' || slug === 'true') {\n      label = label || 'معتبر'; cls = 'table-status--active';\n    } else if (slug === 'expired' || slug === 'inactive' || slug === '0') {\n      label = label || 'منقضی'; cls = 'table-status--expired';\n    } else {\n      label = label || 'نامشخص'; cls = 'table-status--unknown';\n    }\n    return '<span class=\"table-status ' + cls + '\">' + esc(label) + '</span>';\n  }\n\n  /* ---- Build actions cell ---- */\n  function actionsCell(license) {\n    const rn = esc(license.request_number || license.license_number || '');\n    return '<button class=\"table-action\" data-action=\"open-license\" data-request-number=\"' + rn +\n      '\">جزئیات</button>';\n  }\n\n  /* ---- Sort header cell ---- */\n  function headerCell(col) {\n    if (!col.sortable) {\n      return '<th>' + esc(col.label) + '</th>';\n    }\n    const state = window.MojavezApp?.state?.sort;\n    const isActive = state && state.field === col.key;\n    const cls = isActive ? (state.dir === 'asc' ? 'is-asc' : 'is-desc') : '';\n    return '<th class=\"is-sortable ' + cls + '\" data-sort=\"' + esc(col.key) + '\">' +\n      '<span class=\"sort-indicator\"></span>' + esc(col.label) + '</th>';\n  }\n\n  /* ---- Build a body row ---- */\n  function buildRow(license) {\n    const rn = esc(license.request_number || license.license_number || '');\n    let cells = '';\n    COLUMNS.forEach((col) => {\n      if (col.key === 'actions') {\n        cells += '<td>' + actionsCell(license) + '</td>';\n        return;\n      }\n      if (col.key === 'status') {\n        cells += '<td>' + statusCell(license) + '</td>';\n        return;\n      }\n      let val = getCell(license, col);\n      const clampCls = col.clamp ? ' class=\"cell-clamp-' + col.clamp + '\"' : '';\n      cells += '<td' + clampCls + '>' + esc(val) + '</td>';\n    });\n    return '<tr data-request-number=\"' + rn + '\" class=\"is-clickable\">' + cells + '</tr>';\n  }\n\n  /* ---- Filter bar above table ---- */\n  function buildFilterBar() {\n    return '<div class=\"table-filter-bar\">' +\n      '<div class=\"table-filter-bar__search\">' +\n        '<input type=\"search\" id=\"table-search\" placeholder=\"جستجو در عنوان یا نام متقاضی...\" ' +\n          'data-table-filter=\"q\" value=\"' +\n          esc(window.MojavezApp?.state?.filters?.q || '') + '\">' +\n      '</div>' +\n      '<select class=\"table-filter-bar__select\" data-table-filter=\"province\">' +\n        '<option value=\"\">همه استان‌ها</option>' +\n        buildProvinceOptions(window.MojavezApp?.state?.filters?.province) +\n      '</select>' +\n      '<select class=\"table-filter-bar__select\" data-table-filter=\"status\">' +\n        '<option value=\"\">همه وضعیت‌ها</option>' +\n        '<option value=\"active\"' +\n          (window.MojavezApp?.state?.filters?.status === 'active' ? ' selected' : '') +\n          '>معتبر</option>' +\n        '<option value=\"expired\"' +\n          (window.MojavezApp?.state?.filters?.status === 'expired' ? ' selected' : '') +\n          '>منقضی</option>' +\n      '</select>' +\n      '<div class=\"table-filter-bar__actions\">' +\n        '<button class=\"btn btn--secondary btn--sm\" data-action=\"export-csv\">خروجی CSV</button>' +\n        '<button class=\"btn btn--secondary btn--sm\" data-action=\"export-json\">خروجی JSON</button>' +\n        '<button class=\"btn btn--ghost btn--sm\" data-toggle-density title=\"تراکم ردیف‌ها\">تراکم</button>' +\n      '</div>' +\n    '</div>';\n  }\n\n  function buildProvinceOptions(selected) {\n    // Common Iranian provinces; backend can also inject via data attribute\n    const provinces = [\n      'تهران', 'اصفهان', 'فارس', 'خراسان رضوی', 'آذربایجان شرقی',\n      'گیلان', 'مازندران', 'البرز', 'کرمان', 'خوزستان',\n      'آذربایجان غربی', 'کرمانشاه', 'هرمزگان', 'بوشهر', 'سیستان و بلوچستان',\n      'قم', 'زنجان', 'اردبیل', 'همدان', 'مرکزی', 'لرستان', 'کهگیلویه و بویراحمد',\n      'چهارمحال و بختیاری', 'ایلام', 'گلستان', 'خراسان شمالی', 'خراسان جنوبی',\n      'یزد', 'سمنان'\n    ];\n    let html = '';\n    provinces.forEach((p) => {\n      html += '<option value=\"' + esc(p) + '\"' + (selected === p ? ' selected' : '') +\n        '>' + esc(p) + '</option>';\n    });\n    return html;\n  }\n\n  /* ---- Empty state row ---- */\n  function buildEmptyRow() {\n    return '<tr class=\"table-empty\"><td colspan=\"' + COLUMNS.length + '\">' +\n      '<div class=\"table-empty__title\">مجوزی یافت نشد</div>' +\n      '<div class=\"table-empty__text\">با فیلترهای انتخاب‌شده نتیجه‌ای در دسترس نیست.</div>' +\n    '</td></tr>';\n  }\n\n  /* ---- Main table render ---- */\n  function renderTable(licenses, container) {\n    if (!container) container = document.getElementById('table-container');\n    if (!container) return;\n\n    const headerRow = '<tr>' + COLUMNS.map(headerCell).join('') + '</tr>';\n    const bodyRows = (!licenses || licenses.length === 0)\n      ? buildEmptyRow()\n      : licenses.map(buildRow).join('');\n\n    const html = buildFilterBar() +\n      '<div class=\"table-wrapper\" id=\"license-table-wrapper\">' +\n        '<div class=\"table-scroll\">' +\n          '<table class=\"license-table\">' +\n            '<thead>' + headerRow + '</thead>' +\n            '<tbody>' + bodyRows + '</tbody>' +\n          '</table>' +\n        '</div>' +\n        '<div id=\"table-pagination-slot\"></div>' +\n      '</div>';\n\n    container.innerHTML = html;\n\n    wireTableEvents(container);\n  }\n\n  /* ---- Loading state ---- */\n  function renderLoading(container) {\n    if (!container) container = document.getElementById('table-container');\n    if (!container) return;\n    const headerRow = '<tr>' + COLUMNS.map(headerCell).join('') + '</tr>';\n    let rows = '';\n    for (let i = 0; i < 8; i++) {\n      let cells = '';\n      COLUMNS.forEach(() => {\n        cells += '<td><div class=\"skeleton-card__line skeleton-card__line--w80\"></div></td>';\n      });\n      rows += '<tr>' + cells + '</tr>';\n    }\n    container.innerHTML =\n      '<div class=\"table-wrapper\"><div class=\"table-scroll\">' +\n        '<table class=\"license-table\"><thead>' + headerRow + '</thead><tbody>' + rows + '</tbody></table>' +\n      '</div></div>';\n  }\n\n  function renderEmpty(container) {\n    renderTable([], container);\n  }\n\n  /* ---- Pagination rendering ---- */\n  function renderPagination(page, pageSize, total) {\n    const slot = document.getElementById('table-pagination-slot');\n    if (!slot) return;\n    const totalPages = Math.max(1, Math.ceil(total / pageSize));\n    if (total === 0) { slot.innerHTML = ''; return; }\n\n    const from = (page - 1) * pageSize + 1;\n    const to = Math.min(total, page * pageSize);\n\n    let pagesHtml = '';\n    // Prev\n    pagesHtml += '<button class=\"page-btn\" data-action=\"goto-page\" data-page=\"' + (page - 1) +\n      '\"' + (page <= 1 ? ' disabled' : '') + '>&laquo; قبلی</button>';\n\n    // Page numbers with ellipsis\n    const pages = computePageList(page, totalPages);\n    pages.forEach((p) => {\n      if (p === '...') {\n        pagesHtml += '<span class=\"page-btn page-btn--ellipsis\">...</span>';\n      } else {\n        pagesHtml += '<button class=\"page-btn' + (p === page ? ' is-active' : '') +\n          '\" data-action=\"goto-page\" data-page=\"' + p + '\">' + toFa(p) + '</button>';\n      }\n    });\n\n    // Next\n    pagesHtml += '<button class=\"page-btn\" data-action=\"goto-page\" data-page=\"' + (page + 1) +\n      '\"' + (page >= totalPages ? ' disabled' : '') + '>بعدی &raquo;</button>';\n\n    const info = toFa(from) + ' - ' + toFa(to) + ' از ' + toFa(total) + ' مجوز';\n\n    slot.innerHTML = '<div class=\"table-pagination\">' +\n      '<div class=\"table-pagination__pages\">' + pagesHtml + '</div>' +\n      '<div class=\"table-pagination__info\">' + info + '</div>' +\n      '<select class=\"page-size-select\" data-page-size>' +\n        '<option value=\"20\"' + (pageSize === 20 ? ' selected' : '') + '>۲۰ ردیف</option>' +\n        '<option value=\"50\"' + (pageSize === 50 ? ' selected' : '') + '>۵۰ ردیف</option>' +\n        '<option value=\"100\"' + (pageSize === 100 ? ' selected' : '') + '>۱۰۰ ردیف</option>' +\n      '</select>' +\n    '</div>';\n  }\n\n  function computePageList(current, total) {\n    const list = [];\n    if (total <= 7) {\n      for (let i = 1; i <= total; i++) list.push(i);\n      return list;\n    }\n    list.push(1);\n    if (current > 3) list.push('...');\n    const start = Math.max(2, current - 1);\n    const end = Math.min(total - 1, current + 1);\n    for (let i = start; i <= end; i++) list.push(i);\n    if (current < total - 2) list.push('...');\n    list.push(total);\n    return list;\n  }\n\n  /* ---- Wire sort header, row click, filter changes, density toggle ---- */\n  function wireTableEvents(container) {\n    // Sort headers\n    container.querySelectorAll('th.is-sortable').forEach((th) => {\n      th.addEventListener('click', () => {\n        const field = th.getAttribute('data-sort');\n        const state = window.MojavezApp.state;\n        let dir = 'asc';\n        if (state.sort.field === field) {\n          dir = state.sort.dir === 'asc' ? 'desc' : 'asc';\n        }\n        state.sort = { field: field, dir: dir };\n        window.MojavezApp.refreshCurrentView();\n      });\n    });\n\n    // Row click → open detail\n    container.querySelectorAll('tbody tr.is-clickable').forEach((tr) => {\n      tr.addEventListener('click', (e) => {\n        if (e.target.closest('.table-action')) return; // action button handled by delegation\n        const rn = tr.getAttribute('data-request-number');\n        if (rn && window.MojavezApp.openLicenseDetail) {\n          window.MojavezApp.openLicenseDetail(rn);\n        }\n      });\n    });\n\n    // Filter inputs (debounced for search)\n    let searchTimer = null;\n    container.querySelectorAll('[data-table-filter]').forEach((input) => {\n      const evt = input.tagName === 'SELECT' ? 'change' : 'input';\n      input.addEventListener(evt, () => {\n        const key = input.getAttribute('data-table-filter');\n        const val = input.value.trim();\n        const state = window.MojavezApp.state;\n        if (val) state.filters[key] = val;\n        else delete state.filters[key];\n        if (evt === 'input') {\n          clearTimeout(searchTimer);\n          searchTimer = setTimeout(() => {\n            state.page = 1;\n            window.MojavezApp.refreshCurrentView();\n          }, 400);\n        } else {\n          state.page = 1;\n          window.MojavezApp.refreshCurrentView();\n        }\n      });\n    });\n\n    // Density toggle\n    const densityBtn = container.querySelector('[data-toggle-density]');\n    if (densityBtn) {\n      densityBtn.addEventListener('click', () => {\n        const wrap = container.querySelector('#license-table-wrapper');\n        if (!wrap) return;\n        const isCompact = wrap.classList.toggle('is-compact');\n        try { localStorage.setItem('mojavez_table_density', isCompact ? 'compact' : 'comfortable'); } catch (_) {}\n        if (window.MojavezApp.toast) {\n          window.MojavezApp.toast(isCompact ? 'نمایش فشرده' : 'نمایش معمولی', 'info', 1500);\n        }\n      });\n      // Restore saved density\n      try {\n        const saved = localStorage.getItem('mojavez_table_density');\n        if (saved === 'compact') {\n          const wrap = container.querySelector('#license-table-wrapper');\n          if (wrap) wrap.classList.add('is-compact');\n        }\n      } catch (_) {}\n    }\n  }\n\n  /* ---- CSV/JSON export (delegated via app.js actions, but also direct) ---- */\n  function exportData(format) {\n    if (window.MojavezApp && window.MojavezApp.exportLicenses) {\n      window.MojavezApp.exportLicenses(format);\n    }\n  }\n\n  /* ---- Expose API ---- */\n  Tables.renderTable = renderTable;\n  Tables.renderLoading = renderLoading;\n  Tables.renderEmpty = renderEmpty;\n  Tables.renderPagination = renderPagination;\n  Tables.exportData = exportData;\n  Tables.COLUMNS = COLUMNS;\n\n  window.MojavezTables = Tables;\n})();\n"
          },
