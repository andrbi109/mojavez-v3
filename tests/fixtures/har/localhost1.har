            "mimeType": "text/css",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway — License Card View Styles\n   Direction (ECC): dense, scannable, information-first.\n   No cards-in-cards, no decorative gradients. Hierarchy by scale + weight.\n   Tokens live in tokens.css.\n   ============================================ */\n\n/* ---- Card grid ---- */\n.cards-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: var(--sp-4);\n}\n\n/* ---- Single card ---- */\n.license-card {\n  display: flex;\n  flex-direction: column;\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-lg);\n  overflow: hidden;\n  transition: box-shadow var(--t-base), border-color var(--t-base);\n}\n\n.license-card:hover {\n  box-shadow: var(--sh-md);\n  border-color: var(--c-border-strong);\n}\n\n/* ---- Top section: avatar + status ---- */\n.license-card__top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--sp-3);\n  padding: var(--sp-3) var(--sp-4);\n  border-bottom: 1px solid var(--c-border-subtle);\n}\n\n.license-card__avatar {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  overflow: hidden;\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--c-primary-soft);\n  color: var(--c-primary);\n  font-weight: var(--fw-bold);\n  font-size: var(--fs-md);\n  border: 1px solid var(--c-border);\n}\n\n.license-card__avatar img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.license-card__status {\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-semibold);\n  padding: var(--sp-1) var(--sp-3);\n  border-radius: var(--r-pill);\n  white-space: nowrap;\n}\n\n.license-card__status--active {\n  background: var(--c-success-soft);\n  color: var(--c-success);\n}\n\n.license-card__status--expired {\n  background: var(--c-danger-soft);\n  color: var(--c-danger);\n}\n\n.license-card__status--unknown {\n  background: var(--c-surface-sunken);\n  color: var(--c-text-muted);\n}\n\n/* ---- Card body ---- */\n.license-card__body {\n  padding: var(--sp-4);\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: var(--sp-2);\n}\n\n.license-card__title {\n  font-size: var(--fs-base);\n  font-weight: var(--fw-semibold);\n  line-height: var(--lh-tight);\n  color: var(--c-text-strong);\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  min-height: 2.5em;\n}\n\n.license-card__applicant {\n  font-size: var(--fs-sm);\n  color: var(--c-text-muted);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ---- Meta grid ---- */\n.license-card__meta {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: var(--sp-2) var(--sp-3);\n  font-size: var(--fs-xs);\n  margin-top: var(--sp-1);\n}\n\n.license-card__meta-item {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  min-width: 0;\n}\n\n.license-card__meta-label {\n  font-size: var(--fs-xs);\n  color: var(--c-text-subtle);\n}\n\n.license-card__meta-value {\n  color: var(--c-text);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.license-card__meta-value--clamp-3 {\n  white-space: normal;\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  line-height: var(--lh-tight);\n}\n\n/* ---- Footer actions ---- */\n.license-card__footer {\n  display: flex;\n  border-top: 1px solid var(--c-border-subtle);\n}\n\n.license-card__action {\n  flex: 1;\n  padding: var(--sp-3) var(--sp-2);\n  background: transparent;\n  border: none;\n  border-left: 1px solid var(--c-border-subtle);\n  color: var(--c-text-muted);\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-semibold);\n  min-height: var(--touch-target);\n  transition: background var(--t-base), color var(--t-base);\n}\n\n.license-card__action:last-child {\n  border-left: none;\n}\n\n.license-card__action:hover {\n  background: var(--c-surface-sunken);\n  color: var(--c-primary);\n}\n\n/* The \"saved\" bookmark button — amber accent when the license is bookmarked */\n.license-card__action.is-saved {\n  background: var(--c-accent-soft);\n  color: var(--c-accent);\n}\n.license-card__action.is-saved:hover {\n  background: var(--c-accent-soft);\n  color: var(--c-accent);\n}\n\n/* ---- Empty state ---- */\n.license-cards-empty {\n  grid-column: 1 / -1;\n  text-align: center;\n  padding: var(--sp-12) var(--sp-5);\n  color: var(--c-text-muted);\n}\n\n.license-cards-empty__icon {\n  font-size: var(--fs-xl);\n  font-weight: var(--fw-bold);\n  color: var(--c-border-strong);\n  margin-bottom: var(--sp-3);\n}\n\n.license-cards-empty__title {\n  font-size: var(--fs-md);\n  font-weight: var(--fw-semibold);\n  color: var(--c-text);\n  margin-bottom: var(--sp-1);\n}\n\n.license-cards-empty__text {\n  font-size: var(--fs-sm);\n}\n\n/* ---- Skeleton card (loading placeholder) ---- */\n.skeleton-card {\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-lg);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.skeleton-card__top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--sp-3) var(--sp-4);\n  border-bottom: 1px solid var(--c-border-subtle);\n}\n\n.skeleton-card__avatar,\n.skeleton-card__badge,\n.skeleton-card__line,\n.skeleton-card__qr,\n.skeleton-card__footer {\n  background: linear-gradient(\n    90deg,\n    var(--c-border-subtle) 25%,\n    var(--c-surface-sunken) 50%,\n    var(--c-border-subtle) 75%\n  );\n  background-size: 200% 100%;\n  animation: skeleton-pulse 1.4s ease infinite;\n}\n\n.skeleton-card__avatar {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n}\n\n.skeleton-card__badge {\n  width: 60px;\n  height: 22px;\n  border-radius: var(--r-pill);\n}\n\n.skeleton-card__body {\n  padding: var(--sp-4);\n  display: flex;\n  flex-direction: column;\n  gap: var(--sp-3);\n}\n\n.skeleton-card__line {\n  height: 12px;\n  border-radius: var(--r-sm);\n}\n\n.skeleton-card__line--w100 { width: 100%; }\n.skeleton-card__line--w80  { width: 80%; }\n.skeleton-card__line--w60  { width: 60%; }\n.skeleton-card__line--w40  { width: 40%; }\n.skeleton-card__line--h24  { height: 24px; }\n\n.skeleton-card__qr {\n  height: 110px;\n  margin: 0 var(--sp-4) var(--sp-4);\n  border-radius: var(--r-sm);\n}\n\n.skeleton-card__footer {\n  height: var(--touch-target);\n  border-top: 1px solid var(--c-border-subtle);\n}\n\n@keyframes skeleton-pulse {\n  0%   { background-position: 200% 0; }\n  100% { background-position: -200% 0; }\n}\n\n/* ---- Mobile adjustments ---- */\n@media (max-width: 768px) {\n  .cards-grid {\n    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n    gap: var(--sp-3);\n  }\n}\n\n@media (max-width: 480px) {\n  .cards-grid {\n    grid-template-columns: 1fr;\n    gap: var(--sp-3);\n  }\n}\n\n/* ---- QR code in the detail modal ---- */\n.license-detail__qr svg {\n  display: block;\n  width: 180px;\n  height: 180px;\n}\n\n.license-detail__qr a {\n  color: var(--c-primary);\n  text-decoration: none;\n}\n.license-detail__qr a:hover { text-decoration: underline; }\n"
          },
