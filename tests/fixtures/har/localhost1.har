          "content": {
            "size": 28783,
            "mimeType": "application/javascript",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway - Card View Rendering\n   Build license card DOM, XSS-safe, Jalali date\n   ============================================ */\n\n(function () {\n  'use strict';\n\n  const Cards = {};\n\n  /* ---- Helpers from app.js ---- */\n  function esc(str) {\n    return window.MojavezApp ? window.MojavezApp.escapeHtml(str) : String(str || '');\n  }\n\n  function jalali(input) {\n    return window.MojavezApp ? window.MojavezApp.toJalaliDate(input) : (input || '');\n  }\n\n  function toFa(n) {\n    return window.MojavezApp ? window.MojavezApp.toPersianDigits(n) : String(n);\n  }\n\n  /* ---- Status badge logic ---- */\n  function statusBadge(license) {\n    // normalizeLicense (in app.js) already extracted status.slug into license.status\n    // and status.label into license.status_label.\n    const status = (license.status || '').toString().toLowerCase();\n    const label = license.status_label || '';\n    let badgeLabel, cls;\n    if (status === 'active' || status === '1' || status === 'true' || status === 'valid') {\n      badgeLabel = label || 'معتبر';\n      cls = 'license-card__status--active';\n    } else if (status === 'expired' || status === 'inactive' || status === '0') {\n      badgeLabel = label || 'منقضی';\n      cls = 'license-card__status--expired';\n    } else if (status === 'unknown' || status === '') {\n      badgeLabel = label || 'نامشخص';\n      cls = 'license-card__status--unknown';\n    } else {\n      badgeLabel = label || status || 'نامشخص';\n      cls = 'license-card__status--unknown';\n    }\n    return '<span class=\"license-card__status ' + cls + '\">' + esc(badgeLabel) + '</span>';\n  }\n\n  /* ---- Avatar: image if user_image present, else initials ---- */\n  /* ---- IMPORTANT: profile images live on https://mojavez.ir/ (NOT ---- */\n  /* ---- https://qr.mojavez.ir/). Verified in HAR: the upstream site ---- */\n  /* ---- fetches them via https://mojavez.ir/profile-pictures/...png. ---- */\n  /* ---- Using qr.mojavez.ir/profile-pictures/... returns 404. ---- */\n  function avatar(license) {\n    const userImage = license.user_image || license.image;\n    if (userImage) {\n      const url = String(userImage).startsWith('http')\n        ? userImage\n        : 'https://mojavez.ir/' + String(userImage).replace(/^\\//, '');\n      return '<div class=\"license-card__avatar\">' +\n        '<img src=\"' + esc(url) + '\" alt=\"تصویر متقاضی\" loading=\"lazy\" ' +\n        'onerror=\"this.style.display=\\'none\\';this.parentNode.classList.add(\\'no-img\\')\">' +\n        '</div>';\n    }\n    const name = license.applicant_name || license.applicant || '';\n    const initials = extractInitials(name);\n    return '<div class=\"license-card__avatar\">' + esc(initials) + '</div>';\n  }\n\n  function extractInitials(name) {\n    if (!name) return '--';\n    const parts = String(name).trim().split(/\\s+/);\n    if (parts.length === 1) return parts[0].substring(0, 2);\n    return (parts[0][0] || '') + (parts[1][0] || '');\n  }\n\n  /* ---- Build a single card via template literals ---- */\n  function buildCard(license) {\n    const rn = esc(license.request_number || license.license_number || '');\n    const title = esc(license.license_title || license.title || 'بدون عنوان');\n    const applicant = esc(license.applicant_name || license.applicant || '—');\n    // Accept both normalized (province/township/organization) and raw API shape\n    // (province_title/township_title/organization_title) so the card renders\n    // correctly whether or not normalizeLicense() ran on the data.\n    const province = esc(license.province || license.province_title || '—');\n    const township = esc(license.township || license.township_title || license.town || '—');\n    const organization = esc(license.organization || license.organization_title || license.issuer || '—');\n    const date = jalali(license.responded_at || license.issue_date || license.date);\n    // is_saved: backend enriches each license with this flag (true = user bookmarked it).\n    // Default to false if missing (e.g. before the migration ran).\n    const isSaved = license.is_saved === true;\n    const saveBtn = '<button class=\"license-card__action' + (isSaved ? ' is-saved' : '') + '\" ' +\n      'data-action=\"toggle-save\" data-request-number=\"' + rn + '\" ' +\n      'data-saved=\"' + (isSaved ? '1' : '0') + '\" ' +\n      'title=\"' + (isSaved ? 'حذف از ذخیره‌شده‌ها' : 'ذخیره این مجوز') + '\">' +\n      (isSaved ? '★ ذخیره شد' : '☆ ذخیره') +\n    '</button>';\n\n    return '<article class=\"license-card\" data-request-number=\"' + rn + '\">' +\n      '<div class=\"license-card__top\">' +\n        avatar(license) +\n        statusBadge(license) +\n      '</div>' +\n      '<div class=\"license-card__body\">' +\n        '<h3 class=\"license-card__title\" title=\"' + title + '\">' + title + '</h3>' +\n        '<div class=\"license-card__applicant\">' + applicant + '</div>' +\n        '<div class=\"license-card__meta\">' +\n          '<div class=\"license-card__meta-item\">' +\n            '<span class=\"license-card__meta-label\">استان</span>' +\n            '<span class=\"license-card__meta-value\">' + province + '</span>' +\n          '</div>' +\n          '<div class=\"license-card__meta-item\">' +\n            '<span class=\"license-card__meta-label\">شهرستان</span>' +\n            '<span class=\"license-card__meta-value\">' + township + '</span>' +\n          '</div>' +\n          '<div class=\"license-card__meta-item\" style=\"grid-column: 1 / -1;\">' +\n            '<span class=\"license-card__meta-label\">صادرکننده</span>' +\n            '<span class=\"license-card__meta-value license-card__meta-value--clamp-3\">' +\n              organization +\n            '</span>' +\n          '</div>' +\n          '<div class=\"license-card__meta-item\" style=\"grid-column: 1 / -1;\">' +\n            '<span class=\"license-card__meta-label\">تاریخ</span>' +\n            '<span class=\"license-card__meta-value\">' + date + '</span>' +\n          '</div>' +\n        '</div>' +\n        // QR is intentionally NOT on the card — it now lives inside the detail\n        // modal, where it encodes the track URL https://qr.mojavez.ir/track/{rn}\n        // (the user asked for this). The card stays compact; the full track\n        // info + scannable QR open in the detail view.\n      '</div>' +\n      '<div class=\"license-card__footer\">' +\n        '<button class=\"license-card__action\" data-action=\"open-license\" ' +\n          'data-request-number=\"' + rn + '\">جزئیات</button>' +\n        '<button class=\"license-card__action\" data-card-download=\"' + rn + '\">دانلود</button>' +\n        saveBtn +\n      '</div>' +\n    '</article>';\n  }\n\n  /* ---- Empty state ---- */\n  function buildEmpty() {\n    return '<div class=\"license-cards-empty\">' +\n      '<div class=\"license-cards-empty__icon\">[ ]</div>' +\n      '<div class=\"license-cards-empty__title\">مجوزی یافت نشد</div>' +\n      '<div class=\"license-cards-empty__text\">با فیلترهای انتخاب‌شده نتیجه‌ای در دسترس نیست.</div>' +\n    '</div>';\n  }\n\n  /* ---- Skeleton card (loading placeholder) ---- */\n  function buildSkeleton() {\n    return '<div class=\"skeleton-card\">' +\n      '<div class=\"skeleton-card__top\">' +\n        '<div class=\"skeleton-card__avatar\"></div>' +\n        '<div class=\"skeleton-card__badge\"></div>' +\n      '</div>' +\n      '<div class=\"skeleton-card__body\">' +\n        '<div class=\"skeleton-card__line skeleton-card__line--h24 skeleton-card__line--w80\"></div>' +\n        '<div class=\"skeleton-card__line skeleton-card__line--w60\"></div>' +\n        '<div class=\"skeleton-card__line skeleton-card__line--w100\"></div>' +\n        '<div class=\"skeleton-card__line skeleton-card__line--w40\"></div>' +\n      '</div>' +\n      '<div class=\"skeleton-card__qr\"></div>' +\n      '<div class=\"skeleton-card__footer\"></div>' +\n    '</div>';\n  }\n\n  /* ---- Main render: clears container, builds DOM ---- */\n  function renderCards(licenses, container) {\n    if (!container) container = document.getElementById('cards-container');\n    if (!container) return;\n    if (!licenses || licenses.length === 0) {\n      container.innerHTML = buildEmpty();\n      return;\n    }\n    const html = licenses.map(buildCard).join('');\n    container.innerHTML = html;\n  }\n\n  /* ---- Loading state: 8 skeleton cards ---- */\n  function renderLoading(container) {\n    if (!container) container = document.getElementById('cards-container');\n    if (!container) return;\n    let html = '';\n    for (let i = 0; i < 8; i++) html += buildSkeleton();\n    container.innerHTML = html;\n  }\n\n  function renderEmpty(container) {\n    if (!container) container = document.getElementById('cards-container');\n    if (!container) return;\n    container.innerHTML = buildEmpty();\n  }\n\n  /* ---- Prepend a newly-saved license (from LicenseSaved event) ---- */\n  function prependCard(license, container) {\n    if (!container) container = document.getElementById('cards-container');\n    if (!container) return;\n    // If empty state currently shown, clear it\n    if (container.querySelector('.license-cards-empty')) {\n      container.innerHTML = '';\n    }\n    const tpl = document.createElement('div');\n    tpl.innerHTML = buildCard(license);\n    const card = tpl.firstElementChild;\n    if (card) {\n      card.style.opacity = '0';\n      container.insertBefore(card, container.firstChild);\n      // fade in\n      requestAnimationFrame(() => {\n        card.style.transition = 'opacity 300ms ease';\n        card.style.opacity = '1';\n      });\n    }\n  }\n\n  /* ---- Detail modal HTML (used by app.js openLicenseDetail) ---- */\n  /* ---- Accepts BOTH the raw upstream/API shape AND the normalized shape ---- */\n  /* ---- Raw:  {request_number, applicant_name, license_title, organization_title, ---- */\n  /* ----        province_title, township_title, responded_at, status:{id,title,slug,label} } ---- */\n  /* ---- Norm: {request_number, applicant_name, license_title, organization, ---- */\n  /* ----        province, township, responded_at, status:'active', status_label:'معتبر' } ---- */\n  function renderDetailHtml(license) {\n    if (!license) return '<p class=\"text-muted\">اطلاعاتی یافت نشد</p>';\n\n    // Normalize: extract fields whether from raw API or normalized shape\n    const rn = license.request_number || license.license_number || '—';\n    const title = license.license_title || license.title || '—';\n    const applicant = license.applicant_name || license.applicant || '—';\n    const org = license.organization_title || license.organization || license.issuer || '—';\n    const prov = license.province_title || license.province || '—';\n    const town = license.township_title || license.township || license.town || '—';\n    const respondedAt = license.responded_at || license.issue_date || '';\n\n    // Status may be either an object (raw API) or a string (normalized)\n    let statusLabel = 'نامشخص';\n    let statusSlug = '';\n    if (typeof license.status === 'object' && license.status) {\n      statusLabel = license.status.label || license.status.title || license.status.slug || 'نامشخص';\n      statusSlug = license.status.slug || '';\n    } else if (typeof license.status === 'string' && license.status) {\n      statusSlug = license.status;\n      statusLabel = license.status_label || statusSlug;\n    }\n\n    // Status badge styling\n    let badgeCls = 'badge-muted';\n    if (statusSlug === 'active') badgeCls = 'badge-success';\n    else if (statusSlug === 'expired') badgeCls = 'badge-danger';\n\n    // Avatar image URL — images live on mojavez.ir (NOT qr.mojavez.ir).\n    // Verified in HAR: actual fetch is https://mojavez.ir/profile-pictures/...png\n    let avatarHtml = '';\n    const userImage = license.user_image || license.image || null;\n    if (userImage) {\n      const url = String(userImage).startsWith('http')\n        ? userImage\n        : 'https://mojavez.ir/' + String(userImage).replace(/^\\//, '');\n      avatarHtml = '<div class=\"license-detail__avatar\" style=\"text-align:center;margin-bottom:16px;\">' +\n        '<img src=\"' + esc(url) + '\" alt=\"تصویر متقاضی\" style=\"width:96px;height:96px;border-radius:50%;object-fit:cover;border:2px solid var(--border);\" ' +\n        'onerror=\"this.style.display=\\'none\\';this.parentNode.innerHTML=\\'<div style=&quot;width:96px;height:96px;border-radius:50%;background:var(--bg-muted);display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:1.6rem;color:var(--text-muted);&quot;>' + esc(initialsOf(applicant)) + '</div>\\'\">' +\n      '</div>';\n    } else {\n      avatarHtml = '<div class=\"license-detail__avatar\" style=\"text-align:center;margin-bottom:16px;\">' +\n        '<div style=\"width:96px;height:96px;border-radius:50%;background:var(--bg-muted);display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:1.6rem;color:var(--text-muted);\">' +\n          esc(initialsOf(applicant)) +\n        '</div></div>';\n    }\n\n    const rows = [\n      ['شماره مجوز', rn],\n      ['عنوان مجوز', title],\n      ['نام متقاضی', applicant],\n      ['صادرکننده', org],\n      ['استان', prov],\n      ['شهرستان', town],\n      ['تاریخ پاسخ', jalali(respondedAt)],\n    ];\n    let rowsHtml = '';\n    rows.forEach(([label, val]) => {\n      rowsHtml += '<div class=\"form-row\" style=\"border-bottom:1px solid var(--border);padding:8px 0;\">' +\n        '<div style=\"flex:0 0 140px;color:var(--text-muted);font-size:.85rem;\">' + esc(label) + '</div>' +\n        '<div style=\"flex:1;\">' + esc(val) + '</div>' +\n      '</div>';\n    });\n\n    // Status row with a colored badge\n    rowsHtml += '<div class=\"form-row\" style=\"border-bottom:1px solid var(--border);padding:8px 0;\">' +\n      '<div style=\"flex:0 0 140px;color:var(--text-muted);font-size:.85rem;\">وضعیت</div>' +\n      '<div style=\"flex:1;\"><span class=\"badge ' + badgeCls + '\">' + esc(statusLabel) + '</span></div>' +\n    '</div>';\n\n    // Real QR code — encodes the upstream track URL so scanning it opens the\n    // license-tracking page on qr.mojavez.ir. Uses window.MojavezQR (loaded from\n    // /assets/js/qrcode-vendor.js + qr-generator.js). Falls back to a plain\n    // link if the QR library somehow didn't load.\n    let qrHtml = '';\n    const trackUrl = rn !== '—' ? ('https://qr.mojavez.ir/track/' + encodeURIComponent(rn)) : '';\n    if (trackUrl && window.MojavezQR) {\n      const qrSvg = window.MojavezQR.render(trackUrl, {\n        size: 180, margin: 4, dark: '#1e293b', light: '#ffffff'\n      });\n      qrHtml = '<div class=\"license-detail__qr mt-4\" style=\"text-align:center;\">' +\n        '<div style=\"display:inline-block;padding:8px;background:#fff;border:1px solid var(--border);border-radius:8px;\">' +\n          qrSvg +\n        '</div>' +\n        '<div class=\"text-muted\" style=\"font-size:.75rem;margin-top:6px;\">کد رهگیری: ' + toPersianDigitsSafe(rn) + '</div>' +\n        '<a href=\"' + esc(trackUrl) + '\" target=\"_blank\" rel=\"noopener\" class=\"text-muted\" style=\"font-size:.7rem;display:block;margin-top:2px;\">' +\n          'مشاهده در درگاه ملی مجوزها ←' +\n        '</a>' +\n      '</div>';\n    } else if (trackUrl) {\n      qrHtml = '<div class=\"mt-4 text-center\">' +\n        '<a href=\"' + esc(trackUrl) + '\" target=\"_blank\" rel=\"noopener\" class=\"btn btn--ghost btn--sm\">' +\n          'مشاهده در درگاه ملی مجوزها' +\n        '</a>' +\n        '<div class=\"text-muted\" style=\"font-size:.75rem;margin-top:4px;\">کد رهگیری: ' + toPersianDigitsSafe(rn) + '</div>' +\n      '</div>';\n    }\n\n    return '<div>' + avatarHtml + rowsHtml + qrHtml +\n      '<div class=\"modal__footer\" style=\"border:none;padding-top:16px;\">' +\n        '<button class=\"btn btn--secondary\" data-action=\"close-modal\">بستن</button>' +\n        '<button class=\"btn btn--primary\" data-detail-download=\"' +\n          esc(rn) + '\">دانلود جزئیات</button>' +\n      '</div></div>';\n  }\n\n  // Local helper to avoid pulling the full normalize path into the detail modal.\n  function initialsOf(name) {\n    if (!name) return '--';\n    const parts = String(name).trim().split(/\\s+/);\n    if (parts.length === 1) return parts[0].substring(0, 2);\n    return (parts[0][0] || '') + (parts[1][0] || '');\n  }\n  function toPersianDigitsSafe(n) {\n    return window.MojavezApp && window.MojavezApp.toPersianDigits\n      ? window.MojavezApp.toPersianDigits(n) : String(n);\n  }\n\n  /* ---- Wire card + modal download/share buttons via one delegated listener ---- */\n  /* ---- Card:    data-card-download=\"...\"    (button on the license card)     ---- */\n  /* ---- Modal:   data-detail-download=\"...\"  (button in the detail modal)      ---- */\n  /* ---- Share:   data-card-share=\"...\"                                     ---- */\n  /* ---- Previously the modal download button was unwired → 404 from          ---- */\n  /* ---- /api/licenses/{rn}/pdf (which does NOT exist on the backend).         ---- */\n  /* ---- Both download paths now use handleDetailDownload which generates a    ---- */\n  /* ---- print-friendly HTML view client-side and opens it in a new window     ---- */\n  /* ---- so the user can \"Save as PDF\". No server-side PDF dependency.        ---- */\n  // Guard against double-registration: this script tag runs once, but if the\n  // browser re-evaluates it (e.g. via a partial page swap, or a duplicate\n  // <script> include), the click listener would fire twice and every download\n  // button would open two print windows. Use a flag on the document element.\n  if (!document.documentElement.dataset.cardsClickBound) {\n    document.documentElement.dataset.cardsClickBound = '1';\n    document.addEventListener('click', (e) => {\n      const dlCard = e.target.closest('[data-card-download]');\n      if (dlCard) {\n        e.preventDefault();\n        handleDetailDownload(dlCard.getAttribute('data-card-download'));\n        return;\n      }\n      const dlModal = e.target.closest('[data-detail-download]');\n      if (dlModal) {\n        e.preventDefault();\n        handleDetailDownload(dlModal.getAttribute('data-detail-download'));\n        return;\n      }\n      const sh = e.target.closest('[data-card-share]');\n      if (sh) {\n        e.preventDefault();\n        handleCardShare(sh.getAttribute('data-card-share'));\n        return;\n      }\n    });\n  }\n\n  // Fetches the license details and opens a print window so the user can\n  // \"Save as PDF\" via the browser's native print dialog.\n  async function handleDetailDownload(rn) {\n    if (window.MojavezApp) window.MojavezApp.toast('در حال آماده‌سازی فایل برای دانلود...', 'info', 2500);\n    try {\n      // Reuse the existing /api/licenses/{rn} endpoint (returns {ok:true, data:{...}}).\n      const resp = await window.MojavezApp.api('GET', '/api/licenses/' + encodeURIComponent(rn));\n      const license = (resp && resp.data) ? resp.data : resp;\n      openPrintWindow(license);\n      if (window.MojavezApp) window.MojavezApp.toast('فایل آماده شد — برای ذخیره PDF، گزینه «Save as PDF» را انتخاب کنید', 'success', 5000);\n    } catch (e) {\n      if (window.MojavezApp) window.MojavezApp.toast(e.message || 'خطا در دانلود', 'danger');\n    }\n  }\n\n  // Build a print-friendly HTML document and open it in a new window with the\n  // browser's print dialog already shown. The user can save it as PDF.\n  function openPrintWindow(license) {\n    const fa = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n    function faDigits(n) { return String(n).replace(/\\d/g, (d) => fa[+d]); }\n    function jalaliStr(input) {\n      return window.MojavezApp && window.MojavezApp.toJalaliDate\n        ? window.MojavezApp.toJalaliDate(input) : (input || '');\n    }\n    function esc(s) {\n      return String(s == null ? '' : s)\n        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')\n        .replace(/\"/g,'&quot;').replace(/'/g,'&#39;');\n    }\n    const rn = license.request_number || license.license_number || '';\n    const title = license.license_title || license.title || '';\n    const applicant = license.applicant_name || license.applicant || '';\n    const org = license.organization_title || license.organization || license.issuer || '';\n    const prov = license.province_title || license.province || '';\n    const town = license.township_title || license.township || '';\n    const date = jalaliStr(license.responded_at || license.issue_date || '');\n    let statusLabel = '';\n    if (typeof license.status === 'object' && license.status) {\n      statusLabel = license.status.label || license.status.title || '';\n    } else {\n      statusLabel = license.status_label || String(license.status || '');\n    }\n    let imgUrl = '';\n    const userImage = license.user_image || license.image;\n    if (userImage) {\n      imgUrl = String(userImage).startsWith('http')\n        ? userImage\n        : 'https://mojavez.ir/' + String(userImage).replace(/^\\//, '');\n    }\n    const rows = [\n      ['شماره مجوز', faDigits(rn)],\n      ['عنوان مجوز', title],\n      ['نام متقاضی', applicant],\n      ['صادرکننده', org],\n      ['استان', prov],\n      ['شهرستان', town],\n      ['تاریخ پاسخ', date],\n      ['وضعیت', statusLabel],\n    ];\n    const rowsHtml = rows.map(([k,v]) =>\n      '<tr><th style=\"text-align:right;width:30%;padding:8px;border:1px solid #ddd;background:#f8f8f8;\">' + esc(k) + '</th>' +\n      '<td style=\"padding:8px;border:1px solid #ddd;\">' + esc(v) + '</td></tr>'\n    ).join('');\n\n    const imgHtml = imgUrl\n      ? '<div style=\"text-align:center;margin:12px 0;\">' +\n        '<img src=\"' + esc(imgUrl) + '\" alt=\"تصویر متقاضی\" style=\"width:120px;height:120px;border-radius:50%;object-fit:cover;border:1px solid #ddd;\" ' +\n        'onerror=\"this.style.display=\\'none\\'\"></div>'\n      : '';\n\n    // Real QR code — encodes the track URL (https://qr.mojavez.ir/track/{rn})\n    // so scanning the printed PDF opens the upstream license-tracking page.\n    // Generated inline via the MojavezQR wrapper around qrcode-generator.\n    let qrSvg = '';\n    if (rn && window.MojavezQR) {\n      const trackUrl = 'https://qr.mojavez.ir/track/' + encodeURIComponent(rn);\n      qrSvg = window.MojavezQR.render(trackUrl, {\n        size: 150, margin: 4, dark: '#1e293b', light: '#ffffff'\n      });\n    }\n    const qrHtml = qrSvg\n      ? '<div style=\"text-align:center;margin:12px 0;\">' +\n        '<div style=\"display:inline-block;padding:6px;background:#fff;border:1px solid #ddd;border-radius:4px;\">' +\n          qrSvg +\n        '</div>' +\n        '<div style=\"font-size:.7rem;color:#666;margin-top:4px;\">اسکن برای مشاهده در درگاه ملی مجوزها</div>' +\n      '</div>'\n      : '';\n    const trackUrl = rn ? ('https://qr.mojavez.ir/track/' + encodeURIComponent(rn)) : '';\n    const trackLinkHtml = trackUrl\n      ? '<div style=\"text-align:center;margin:4px 0 12px 0;font-size:.8rem;color:#666;\">' +\n        'لینک رهگیری: <a href=\"' + esc(trackUrl) + '\" style=\"color:#2563eb;\">' + esc(trackUrl) + '</a></div>'\n      : '';\n\n    const doc =\n      '<!doctype html><html lang=\"fa\" dir=\"rtl\"><head><meta charset=\"utf-8\">' +\n      '<title>مجوز شماره ' + esc(faDigits(rn)) + '</title>' +\n      '<style>' +\n      'body{font-family:Tahoma,Vazirmatn,IRANSans,sans-serif;padding:24px;color:#222;line-height:1.6;}' +\n      'h1{font-size:1.4rem;text-align:center;margin:0 0 8px 0;}' +\n      '.subtitle{text-align:center;color:#666;font-size:.9rem;margin-bottom:20px;}' +\n      'table{width:100%;border-collapse:collapse;margin-top:12px;}' +\n      '@media print{body{padding:0;}}' +\n      '</style></head><body>' +\n      '<h1>جزئیات مجوز</h1>' +\n      '<div class=\"subtitle\">شماره رهگیری: ' + esc(faDigits(rn)) + '</div>' +\n      imgHtml + qrHtml + trackLinkHtml +\n      '<table>' + rowsHtml + '</table>' +\n      '<div style=\"margin-top:24px;text-align:center;color:#999;font-size:.8rem;\">' +\n      'این برگه توسط درگاه اختصاصی مجوزها تولید شده است.</div>' +\n      '</body></html>';\n\n    const w = window.open('', '_blank');\n    if (!w) {\n      // Popup blocked — fall back to a blob URL.\n      const blob = new Blob([doc], { type: 'text/html' });\n      const url = URL.createObjectURL(blob);\n      location.href = url;\n      return;\n    }\n    w.document.open();\n    w.document.write(doc);\n    w.document.close();\n    // Give the images a moment to load before showing the print dialog.\n    setTimeout(function () {\n      try { w.focus(); w.print(); } catch (_) {}\n    }, 600);\n  }\n\n\n  async function handleCardShare(rn) {\n    const shareUrl = location.origin + '/license/' + encodeURIComponent(rn);\n    if (navigator.share) {\n      try {\n        await navigator.share({ title: 'مجوز', url: shareUrl });\n        return;\n      } catch (_) { /* user cancelled */ }\n    }\n    try {\n      await navigator.clipboard.writeText(shareUrl);\n      if (window.MojavezApp) window.MojavezApp.toast('لینک در کلیپ‌بورد کپی شد', 'success');\n    } catch (_) {\n      if (window.MojavezApp) window.MojavezApp.toast('لینک: ' + shareUrl, 'info', 8000);\n    }\n  }\n\n  /* ---- Cards pagination ---- */\n  /* ---- The table view has its own pagination; cards view needs one too,  ---- */\n  /* ---- otherwise users cannot navigate when total > page_size.           ---- */\n  /* ---- Shares the same data-action=\"goto-page\" / data-page-size          ---- */\n  /* ---- delegation in app.js so no new event wiring is needed.            ---- */\n  function renderCardsPagination(page, pageSize, total) {\n    const slot = document.getElementById('cards-pagination-slot');\n    if (!slot) return;\n    const totalPages = Math.max(1, Math.ceil(total / pageSize));\n    if (total === 0) { slot.innerHTML = ''; return; }\n\n    const from = (page - 1) * pageSize + 1;\n    const to = Math.min(total, page * pageSize);\n\n    const fa = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n    function faNum(n) { return String(n).replace(/\\d/g, (d) => fa[+d]); }\n\n    // Compute the page list with ellipsis (same logic as tables.js).\n    function computePageList(current, t) {\n      const list = [];\n      if (t <= 7) { for (let i = 1; i <= t; i++) list.push(i); return list; }\n      list.push(1);\n      if (current > 3) list.push('...');\n      const start = Math.max(2, current - 1);\n      const end = Math.min(t - 1, current + 1);\n      for (let i = start; i <= end; i++) list.push(i);\n      if (current < t - 2) list.push('...');\n      list.push(t);\n      return list;\n    }\n\n    let pagesHtml = '';\n    pagesHtml += '<button class=\"page-btn\" data-action=\"goto-page\" data-page=\"' + (page - 1) +\n      '\"' + (page <= 1 ? ' disabled' : '>&laquo; قبلی</button>');\n\n    // Re-write prev button properly (string concat above ends with '>' or 'disabled>')\n    pagesHtml = '<button class=\"page-btn\" data-action=\"goto-page\" data-page=\"' + (page - 1) +\n      '\"' + (page <= 1 ? ' disabled>&laquo; قبلی</button>' : '>&laquo; قبلی</button>');\n\n    const pages = computePageList(page, totalPages);\n    pages.forEach((p) => {\n      if (p === '...') {\n        pagesHtml += '<span class=\"page-btn page-btn--ellipsis\">...</span>';\n      } else {\n        pagesHtml += '<button class=\"page-btn' + (p === page ? ' is-active' : '') +\n          '\" data-action=\"goto-page\" data-page=\"' + p + '\">' + faNum(p) + '</button>';\n      }\n    });\n\n    pagesHtml += '<button class=\"page-btn\" data-action=\"goto-page\" data-page=\"' + (page + 1) +\n      '\"' + (page >= totalPages ? ' disabled>بعدی &raquo;</button>' : '>بعدی &raquo;</button>');\n\n    const info = faNum(from) + ' - ' + faNum(to) + ' از ' + faNum(total) + ' مجوز';\n\n    slot.innerHTML = '<div class=\"table-pagination cards-pagination\">' +\n      '<div class=\"table-pagination__pages\">' + pagesHtml + '</div>' +\n      '<div class=\"table-pagination__info\">' + info + '</div>' +\n      '<select class=\"page-size-select\" data-page-size>' +\n        '<option value=\"20\"' + (pageSize === 20 ? ' selected' : '') + '>۲۰ ردیف</option>' +\n        '<option value=\"50\"' + (pageSize === 50 ? ' selected' : '') + '>۵۰ ردیف</option>' +\n        '<option value=\"100\"' + (pageSize === 100 ? ' selected' : '') + '>۱۰۰ ردیف</option>' +\n      '</select>' +\n    '</div>';\n  }\n\n  /* ---- Expose API ---- */\n  Cards.renderCards = renderCards;\n  Cards.renderLoading = renderLoading;\n  Cards.renderEmpty = renderEmpty;\n  Cards.prependCard = prependCard;\n  Cards.renderDetailHtml = renderDetailHtml;\n  Cards.buildCard = buildCard;\n  Cards.buildSkeleton = buildSkeleton;\n  Cards.renderCardsPagination = renderCardsPagination;\n\n  window.MojavezCards = Cards;\n})();\n"
          },
