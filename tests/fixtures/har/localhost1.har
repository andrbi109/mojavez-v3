          "content": {
            "size": 15284,
            "mimeType": "text/css",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway — Main App Styles (RTL, dark mode)\n   Direction (ECC frontend-design-direction): operational tool →\n   dense, quiet, scannable. Tokens live in tokens.css.\n   ============================================ */\n\n/* ---- Reset & base ---- */\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\nhtml {\n  direction: rtl;\n  font-size: 16px;\n  scroll-behavior: smooth;\n}\nbody {\n  font-family: var(--font-base);\n  background: var(--c-bg);\n  color: var(--c-text);\n  font-size: var(--fs-base);\n  line-height: var(--lh-base);\n  min-height: 100vh;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\na {\n  color: var(--c-primary);\n  text-decoration: none;\n  transition: color var(--t-base);\n}\na:hover { color: var(--c-primary-hover); }\nbutton {\n  font-family: inherit;\n  cursor: pointer;\n  color: inherit;\n}\n\n/* ---- Skip link (a11y, keyboard users) ---- */\n.skip-link {\n  position: absolute;\n  top: -100px;\n  right: var(--sp-2);\n  z-index: 2000;\n  background: var(--c-primary);\n  color: var(--c-text-on-primary);\n  padding: var(--sp-2) var(--sp-4);\n  border-radius: var(--r-sm);\n  font-weight: var(--fw-semibold);\n  font-size: var(--fs-sm);\n}\n.skip-link:focus {\n  top: var(--sp-2);\n}\n\n/* ---- Top navigation bar (sticky, dense) ---- */\n.app-nav {\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  height: var(--nav-height);\n  display: flex;\n  align-items: center;\n  gap: var(--sp-3);\n  padding: 0 var(--sp-5);\n  background: var(--c-surface);\n  border-bottom: 1px solid var(--c-border);\n  box-shadow: var(--sh-xs);\n}\n.app-nav__brand {\n  font-size: var(--fs-md);\n  font-weight: var(--fw-bold);\n  color: var(--c-primary);\n  white-space: nowrap;\n  letter-spacing: -0.01em;\n}\n.app-nav__spacer { flex: 1; }\n.app-nav__btn {\n  background: transparent;\n  border: 1px solid var(--c-border);\n  color: var(--c-text);\n  padding: var(--sp-1) var(--sp-3);\n  border-radius: var(--r-sm);\n  font-size: var(--fs-sm);\n  min-height: var(--touch-target);\n  min-width: var(--touch-target);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: background var(--t-base), border-color var(--t-base);\n}\n.app-nav__btn:hover {\n  background: var(--c-surface-sunken);\n  border-color: var(--c-primary);\n}\n.app-nav__btn--icon {\n  display: none;\n  width: var(--touch-target);\n  height: var(--touch-target);\n  padding: 0;\n}\n.app-nav__link {\n  color: var(--c-text-muted);\n  font-size: var(--fs-sm);\n  font-weight: var(--fw-medium);\n  padding: var(--sp-1) var(--sp-3);\n  border-radius: var(--r-sm);\n  min-height: var(--touch-target);\n  display: inline-flex;\n  align-items: center;\n  transition: color var(--t-base), background var(--t-base);\n}\n.app-nav__link:hover { color: var(--c-text); background: var(--c-primary-soft); }\n.app-nav__link.is-active {\n  color: var(--c-primary);\n  background: var(--c-primary-soft);\n  font-weight: var(--fw-semibold);\n}\n\n/* ---- Layout wrapper ---- */\n.app-layout {\n  display: flex;\n  min-height: calc(100vh - var(--nav-height));\n}\n\n/* ---- Sidebar filter panel ---- */\n.app-sidebar {\n  width: var(--sidebar-width);\n  flex-shrink: 0;\n  background: var(--c-surface);\n  border-left: 1px solid var(--c-border);\n  padding: var(--sp-5);\n  position: sticky;\n  top: var(--nav-height);\n  height: calc(100vh - var(--nav-height));\n  overflow-y: auto;\n}\n.app-sidebar__title {\n  font-size: var(--fs-sm);\n  font-weight: var(--fw-bold);\n  letter-spacing: 0.02em;\n  text-transform: none;\n  margin-bottom: var(--sp-3);\n  color: var(--c-text-strong);\n}\n.app-sidebar__section { margin-bottom: var(--sp-6); }\n.app-sidebar.is-hidden { display: none; }\n\n.app-backdrop {\n  display: none;\n  position: fixed;\n  inset: 0;\n  background: rgba(15, 23, 42, 0.5);\n  z-index: 99;\n}\n.app-backdrop.is-visible { display: block; }\n\n/* ---- Main content area ---- */\n.app-main {\n  flex: 1;\n  min-width: 0;\n  padding: var(--sp-6);\n}\n.app-main__header {\n  display: flex;\n  align-items: center;\n  gap: var(--sp-3);\n  margin-bottom: var(--sp-5);\n  flex-wrap: wrap;\n}\n.app-main__title {\n  font-size: var(--fs-lg);\n  font-weight: var(--fw-bold);\n  color: var(--c-text-strong);\n}\n.app-main__count {\n  color: var(--c-text-muted);\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-semibold);\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-pill);\n  padding: var(--sp-1) var(--sp-3);\n}\n\n/* Toolbar (All / Saved toggle) */\n.app-main__toolbar {\n  margin-inline-start: auto;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--sp-1);\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-sm);\n  padding: var(--sp-1);\n}\n.app-main__toolbar .btn--sm {\n  border-radius: var(--r-sm);\n  padding: var(--sp-1) var(--sp-3);\n  min-height: 32px;\n}\n.app-main__toolbar .btn--sm.is-active {\n  background: var(--c-primary);\n  color: var(--c-text-on-primary);\n  border-color: var(--c-primary);\n}\n\n/* ---- Status bar (used by SSE) ---- */\n.app-status-bar {\n  display: none;\n  align-items: center;\n  gap: var(--sp-2);\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-right: 3px solid var(--c-primary);\n  padding: var(--sp-2) var(--sp-4);\n  border-radius: var(--r-sm);\n  margin-bottom: var(--sp-4);\n  font-size: var(--fs-sm);\n  color: var(--c-text-muted);\n}\n.app-status-bar.is-visible { display: flex; }\n.app-status-bar__dot {\n  width: var(--sp-2);\n  height: var(--sp-2);\n  border-radius: 50%;\n  background: var(--c-accent);\n  animation: pulse 1.2s infinite;\n}\n\n/* ---- Footer ---- */\n.app-footer {\n  border-top: 1px solid var(--c-border);\n  background: var(--c-surface);\n  padding: var(--sp-4) var(--sp-5);\n  text-align: center;\n  color: var(--c-text-muted);\n  font-size: var(--fs-xs);\n}\n\n/* ---- Loading spinner (CSS-only, no SVG) ---- */\n.spinner {\n  width: 32px;\n  height: 32px;\n  border: 3px solid var(--c-border);\n  border-top-color: var(--c-primary);\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n.spinner--sm { width: 18px; height: 18px; border-width: 2px; }\n.spinner--lg { width: 48px; height: 48px; border-width: 4px; }\n.spinner-wrap {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--sp-10);\n  flex-direction: column;\n  gap: var(--sp-3);\n  color: var(--c-text-muted);\n  font-size: var(--fs-sm);\n}\n@keyframes spin { to { transform: rotate(360deg); } }\n@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }\n\n/* ---- Toast notifications ---- */\n.toast-stack {\n  position: fixed;\n  top: calc(var(--nav-height) + 12px);\n  left: var(--sp-4);\n  z-index: 1000;\n  display: flex;\n  flex-direction: column;\n  gap: var(--sp-2);\n  max-width: 360px;\n}\n.toast {\n  background: var(--c-surface-raised);\n  border: 1px solid var(--c-border);\n  border-right: 4px solid var(--c-text-muted);\n  padding: var(--sp-3) var(--sp-4);\n  border-radius: var(--r-md);\n  box-shadow: var(--sh-md);\n  font-size: var(--fs-sm);\n  animation: toast-in var(--t-base);\n  word-break: break-word;\n  cursor: pointer;\n}\n.toast--success { border-right-color: var(--c-success); }\n.toast--danger  { border-right-color: var(--c-danger); }\n.toast--info    { border-right-color: var(--c-primary); }\n.toast--warning { border-right-color: var(--c-warning); }\n.toast__title {\n  font-weight: var(--fw-bold);\n  margin-bottom: 2px;\n  display: block;\n}\n.toast__body { color: var(--c-text-muted); }\n.toast.is-leaving { animation: toast-out var(--t-base) forwards; }\n@keyframes toast-in {\n  from { opacity: 0; transform: translateX(-12px); }\n  to { opacity: 1; transform: translateX(0); }\n}\n@keyframes toast-out {\n  from { opacity: 1; transform: translateX(0); }\n  to { opacity: 0; transform: translateX(-12px); }\n}\n\n/* ---- Modal dialog (overlay + centered card) ---- */\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(15, 23, 42, 0.55);\n  z-index: 500;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  padding: var(--sp-4);\n}\n.modal-overlay.is-open {\n  display: flex;\n  animation: fade-in var(--t-fast);\n}\n.modal {\n  background: var(--c-surface-raised);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-xl);\n  box-shadow: var(--sh-lg);\n  width: 100%;\n  max-width: 640px;\n  max-height: 90vh;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  animation: modal-in var(--t-base);\n}\n.modal--lg { max-width: 900px; }\n.modal--sm { max-width: 420px; }\n.modal__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--sp-4) var(--sp-5);\n  border-bottom: 1px solid var(--c-border);\n}\n.modal__title {\n  font-size: var(--fs-md);\n  font-weight: var(--fw-bold);\n}\n.modal__close {\n  background: transparent;\n  border: none;\n  font-size: 1.4rem;\n  line-height: 1;\n  color: var(--c-text-muted);\n  padding: var(--sp-1) var(--sp-2);\n  border-radius: var(--r-sm);\n  min-width: var(--touch-target);\n  min-height: var(--touch-target);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n.modal__close:hover { background: var(--c-surface-sunken); color: var(--c-text); }\n.modal__body { padding: var(--sp-5); overflow-y: auto; }\n.modal__footer {\n  padding: var(--sp-3) var(--sp-5);\n  border-top: 1px solid var(--c-border);\n  display: flex;\n  gap: var(--sp-2);\n  justify-content: flex-start;\n}\n@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }\n@keyframes modal-in {\n  from { opacity: 0; transform: translateY(12px) scale(0.98); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n/* ---- Form inputs ---- */\n.form-group { margin-bottom: var(--sp-4); }\n.form-label {\n  display: block;\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-medium);\n  color: var(--c-text-muted);\n  margin-bottom: var(--sp-1);\n}\n.form-control,\ninput[type=\"text\"], input[type=\"search\"], input[type=\"date\"],\ninput[type=\"number\"], select, textarea {\n  width: 100%;\n  padding: var(--sp-2) var(--sp-3);\n  font-family: var(--font-base);\n  font-size: var(--fs-sm);\n  color: var(--c-text);\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-sm);\n  transition: border-color var(--t-base), box-shadow var(--t-base);\n  min-height: var(--touch-target);\n}\n.form-control:focus, input:focus, select:focus, textarea:focus {\n  outline: none;\n  border-color: var(--c-primary);\n  box-shadow: var(--sh-focus);\n}\n.form-control::placeholder, input::placeholder {\n  color: var(--c-text-subtle);\n}\nselect:disabled, input:disabled {\n  background: var(--c-surface-sunken);\n  color: var(--c-text-subtle);\n  cursor: not-allowed;\n}\n.form-row { display: flex; gap: var(--sp-3); flex-wrap: wrap; }\n.form-row > .form-group { flex: 1; min-width: 140px; }\n\n/* ---- Buttons ---- */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--sp-1);\n  padding: var(--sp-2) var(--sp-4);\n  font-size: var(--fs-sm);\n  font-weight: var(--fw-semibold);\n  border: 1px solid transparent;\n  border-radius: var(--r-md);\n  background: var(--c-surface);\n  color: var(--c-text);\n  min-height: var(--touch-target);\n  transition: background var(--t-base), border-color var(--t-base), opacity var(--t-base);\n}\n.btn:disabled { opacity: 0.6; cursor: not-allowed; }\n.btn--primary {\n  background: var(--c-primary);\n  color: var(--c-text-on-primary);\n  border-color: var(--c-primary);\n}\n.btn--primary:hover:not(:disabled) {\n  background: var(--c-primary-hover);\n  border-color: var(--c-primary-hover);\n}\n.btn--secondary {\n  background: var(--c-surface);\n  color: var(--c-text);\n  border-color: var(--c-border);\n}\n.btn--secondary:hover:not(:disabled) {\n  border-color: var(--c-primary);\n  color: var(--c-primary);\n}\n.btn--danger {\n  background: var(--c-danger);\n  color: var(--c-text-on-primary);\n  border-color: var(--c-danger);\n}\n.btn--danger:hover:not(:disabled) { opacity: 0.9; }\n.btn--ghost {\n  background: transparent;\n  border-color: transparent;\n  color: var(--c-text-muted);\n}\n.btn--ghost:hover:not(:disabled) {\n  background: var(--c-surface-sunken);\n  color: var(--c-text);\n}\n.btn--sm {\n  padding: var(--sp-1) var(--sp-3);\n  font-size: var(--fs-xs);\n  min-height: 32px;\n}\n\n/* ---- View toggle (cards/table) ---- */\n.view-toggle {\n  display: inline-flex;\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-sm);\n  overflow: hidden;\n}\n.view-toggle__btn {\n  padding: var(--sp-1) var(--sp-4);\n  background: transparent;\n  border: none;\n  color: var(--c-text-muted);\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-medium);\n  min-height: var(--touch-target);\n  transition: background var(--t-base), color var(--t-base);\n}\n.view-toggle__btn:hover { color: var(--c-text); }\n.view-toggle__btn.is-active {\n  background: var(--c-primary);\n  color: var(--c-text-on-primary);\n  font-weight: var(--fw-semibold);\n}\n\n/* ---- Progress bar ---- */\n.progress {\n  width: 100%;\n  height: var(--sp-2);\n  background: var(--c-border-subtle);\n  border-radius: var(--r-pill);\n  overflow: hidden;\n}\n.progress__bar {\n  height: 100%;\n  background: var(--c-primary);\n  border-radius: var(--r-pill);\n  transition: width var(--t-slow);\n  width: 0%;\n}\n.progress__bar--success { background: var(--c-success); }\n.progress__bar--danger  { background: var(--c-danger); }\n\n/* ---- Badges ---- */\n.badge {\n  display: inline-block;\n  padding: 2px var(--sp-2);\n  border-radius: var(--r-pill);\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-semibold);\n}\n.badge--success { background: var(--c-success-soft); color: var(--c-success); }\n.badge--danger  { background: var(--c-danger-soft); color: var(--c-danger); }\n.badge--muted   { background: var(--c-surface-sunken); color: var(--c-text-muted); }\n.badge--info    { background: var(--c-info-soft); color: var(--c-primary); }\n\n/* ---- Utility ---- */\n.text-muted { color: var(--c-text-muted); }\n.text-center { text-align: center; }\n.hidden { display: none !important; }\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* ---- Responsive: tablet (<= 1024px) ---- */\n@media (max-width: 1024px) {\n  :root { --sidebar-width: 260px; }\n  .app-main { padding: var(--sp-5); }\n}\n\n/* ---- Responsive: mobile (<= 768px) ---- */\n@media (max-width: 768px) {\n  :root { --sidebar-width: 280px; }\n  .app-sidebar {\n    position: fixed;\n    top: var(--nav-height);\n    right: 0;\n    height: calc(100vh - var(--nav-height));\n    z-index: 100;\n    transform: translateX(100%);\n    transition: transform var(--t-base);\n    border-left: none;\n    border-right: 1px solid var(--c-border);\n  }\n  .app-sidebar.is-open { transform: translateX(0); }\n  .app-nav__btn--icon { display: inline-flex; }\n  .app-nav__brand { font-size: var(--fs-sm); }\n  .app-main { padding: var(--sp-3); }\n  .app-main__title { font-size: var(--fs-md); }\n  .toast-stack { left: var(--sp-2); right: var(--sp-2); max-width: none; }\n  .modal { max-height: 95vh; }\n  .form-row { flex-direction: column; }\n}\n\n/* ---- Responsive: very small (<= 480px) ---- */\n@media (max-width: 480px) {\n  .app-nav { padding: 0 var(--sp-3); gap: var(--sp-2); }\n  .app-main__header { gap: var(--sp-2); }\n  .modal__footer { flex-direction: column-reverse; }\n  .modal__footer .btn { width: 100%; justify-content: center; }\n}\n"
          },
