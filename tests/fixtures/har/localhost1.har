            "text": "/**\n * MojavezQR — thin wrapper around the vendored qrcode-generator library\n * (public/MIT, Kazuhiko Arase). Provides a simple SVG rendering API for\n * embedding QR codes inline in the page or in a print window.\n *\n * The vendored library lives at /public/assets/js/qrcode-vendor.js and MUST\n * be loaded BEFORE this file. It exposes a global `qrcode` function.\n *\n * Why a real QR (not a decorative SVG): the previous \"qrPlaceholder\" rendered\n * a fake grid that no phone could scan. The user asked for a QR based on the\n * track URL (https://qr.mojavez.ir/track/{request_number}) so that scanning\n * it opens the upstream license-tracking page. This wrapper produces a\n * spec-compliant QR that any phone camera can decode.\n *\n * Public API:\n *   window.MojavezQR.render(text, opts) → SVG string\n *     opts.size   (default 200)   — pixel size of the SVG viewBox\n *     opts.margin (default 4)     — quiet-zone modules (4 is the spec minimum)\n *     opts.dark   (default '#1e293b') — module color\n *     opts.light  (default '#ffffff') — background color\n *     opts.level  (default 'M')   — error correction level: L/M/Q/H\n *   window.MojavezQR.svgDataUrl(text, opts) → data: URL (for <img src>)\n */\n(function () {\n  'use strict';\n\n  function render(text, opts) {\n    opts = opts || {};\n    var pxSize = opts.size || 200;\n    var margin = opts.margin != null ? opts.margin : 4;\n    var dark = opts.dark || '#1e293b';\n    var light = opts.light || '#ffffff';\n    var level = opts.level || 'M'; // L/M/Q/H\n\n    if (typeof window.qrcode !== 'function') {\n      // Vendored library not loaded — render an empty placeholder so the page\n      // doesn't crash. The caller should ensure qrcode-vendor.js is included.\n      return '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ' + pxSize + ' ' + pxSize + '\" ' +\n        'width=\"' + pxSize + '\" height=\"' + pxSize + '\" role=\"img\" aria-label=\"QR (book missing)\">' +\n        '<rect width=\"' + pxSize + '\" height=\"' + pxSize + '\" fill=\"' + light + '\"/>' +\n        '<text x=\"50%\" y=\"50%\" text-anchor=\"middle\" fill=\"' + dark + '\" font-size=\"10\">QR</text>' +\n        '</svg>';\n    }\n\n    // qrcode(typeNumber, errorCorrectionLevel). typeNumber 0 = auto-detect\n    // the smallest version that fits the data.\n    var qr = window.qrcode(0, level);\n    // Use UTF-8 byte encoding so non-ASCII characters in URLs (rare but possible)\n    // are encoded correctly.\n    if (window.qrcode.stringToBytesFuncs && window.qrcode.stringToBytesFuncs['UTF-8']) {\n      window.qrcode.stringToBytes = window.qrcode.stringToBytesFuncs['UTF-8'];\n    }\n    qr.addData(text);\n    qr.make();\n\n    var moduleCount = qr.getModuleCount();\n    var totalModules = moduleCount + margin * 2;\n    var cellSize = pxSize / totalModules;\n\n    // Build the SVG: one background rect, then one rect per dark module.\n    // Grouping dark rects and setting fill once would be smaller, but\n    // individual rects are simpler and render fine for QR sizes (≤ ~177 modules).\n    var rects = '';\n    for (var r = 0; r < moduleCount; r++) {\n      for (var c = 0; c < moduleCount; c++) {\n        if (qr.isDark(r, c)) {\n          rects += '<rect x=\"' + ((c + margin) * cellSize).toFixed(3) +\n            '\" y=\"' + ((r + margin) * cellSize).toFixed(3) +\n            '\" width=\"' + cellSize.toFixed(3) +\n            '\" height=\"' + cellSize.toFixed(3) +\n            '\" fill=\"' + dark + '\"/>';\n        }\n      }\n    }\n\n    return '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ' + pxSize + ' ' + pxSize + '\" ' +\n      'width=\"' + pxSize + '\" height=\"' + pxSize + '\" role=\"img\" aria-label=\"کد QR\">' +\n      '<rect width=\"' + pxSize + '\" height=\"' + pxSize + '\" fill=\"' + light + '\"/>' +\n      rects + '</svg>';\n  }\n\n  function svgDataUrl(text, opts) {\n    var svg = render(text, opts);\n    // encodeURIComponent keeps the SVG valid in a data: URL across browsers.\n    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);\n  }\n\n  window.MojavezQR = {\n    render: render,\n    svgDataUrl: svgDataUrl\n  };\n})();\n"
          },
