          "content": {
            "size": 7131,
            "mimeType": "text/css",
            "compression": 0,
            "text": "/* ============================================\n   Mojavez Gateway — License Detail View Styles\n   Direction (ECC): standalone detail page, dense metadata table,\n   QR card, identity card. Tokens from tokens.css.\n   ============================================ */\n\n.app-main--detail {\n  max-width: var(--content-narrow);\n  margin: 0 auto;\n  padding: var(--sp-6);\n}\n\n/* ---- Header with breadcrumb ---- */\n.detail-header {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--sp-4);\n  margin-bottom: var(--sp-6);\n  flex-wrap: wrap;\n}\n.detail-header__back {\n  font-size: var(--fs-sm);\n  color: var(--c-text-muted);\n  padding: var(--sp-2) var(--sp-3);\n  border-radius: var(--r-sm);\n  min-height: var(--touch-target);\n  display: inline-flex;\n  align-items: center;\n  text-decoration: none;\n  transition: background var(--t-base), color var(--t-base);\n}\n.detail-header__back:hover {\n  background: var(--c-primary-soft);\n  color: var(--c-primary);\n}\n.detail-header__titles { flex: 1; min-width: 0; }\n.detail-header__crumb {\n  font-size: var(--fs-xs);\n  color: var(--c-text-muted);\n  margin-bottom: var(--sp-1);\n  display: flex;\n  gap: var(--sp-2);\n  align-items: center;\n  flex-wrap: wrap;\n}\n.detail-header__crumb a { color: var(--c-primary); }\n.detail-header__crumb span { color: var(--c-text-subtle); }\n.detail-header__title {\n  font-size: var(--fs-lg);\n  font-weight: var(--fw-bold);\n  color: var(--c-text-strong);\n  line-height: var(--lh-tight);\n  letter-spacing: -0.01em;\n}\n.detail-header__actions {\n  display: inline-flex;\n  gap: var(--sp-2);\n  flex-wrap: wrap;\n}\n\n/* ---- Detail grid: identity + QR ---- */\n.detail-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 280px;\n  gap: var(--grid-gap);\n  margin-bottom: var(--sp-5);\n}\n\n/* ---- Detail card (shared) ---- */\n.detail-card {\n  background: var(--c-surface);\n  border: 1px solid var(--c-border);\n  border-radius: var(--r-lg);\n  padding: var(--sp-5);\n}\n.detail-card__title {\n  font-size: var(--fs-sm);\n  font-weight: var(--fw-bold);\n  color: var(--c-text-strong);\n  margin-bottom: var(--sp-4);\n  letter-spacing: 0.01em;\n}\n\n/* ---- Identity card ---- */\n.detail-identity {\n  display: flex;\n  align-items: center;\n  gap: var(--sp-4);\n  flex-wrap: wrap;\n}\n.detail-identity__avatar {\n  width: 56px;\n  height: 56px;\n  border-radius: 50%;\n  background: var(--c-primary-soft);\n  color: var(--c-primary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--fs-lg);\n  font-weight: var(--fw-bold);\n  border: 1px solid var(--c-border);\n  overflow: hidden;\n  flex-shrink: 0;\n}\n.detail-identity__avatar img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n.detail-identity__body { flex: 1; min-width: 0; }\n.detail-identity__name {\n  font-size: var(--fs-md);\n  font-weight: var(--fw-semibold);\n  color: var(--c-text-strong);\n  line-height: var(--lh-tight);\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.detail-identity__org {\n  font-size: var(--fs-sm);\n  color: var(--c-text-muted);\n  margin-top: 2px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.detail-status {\n  font-size: var(--fs-xs);\n  font-weight: var(--fw-semibold);\n  padding: var(--sp-1) var(--sp-3);\n  border-radius: var(--r-pill);\n  background: var(--c-surface-sunken);\n  color: var(--c-text-muted);\n  white-space: nowrap;\n}\n.detail-status.is-active { background: var(--c-success-soft); color: var(--c-success); }\n.detail-status.is-expired { background: var(--c-danger-soft); color: var(--c-danger); }\n\n/* ---- QR card ---- */\n.detail-card--qr {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n}\n.detail-card--qr .detail-card__title {\n  align-self: stretch;\n  text-align: right;\n}\n.detail-qr {\n  width: 200px;\n  height: 200px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--c-surface-sunken);\n  border-radius: var(--r-md);\n  padding: var(--sp-3);\n  margin: 0 auto var(--sp-3);\n}\n.detail-qr svg, .detail-qr img {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n.detail-qr__hint {\n  font-size: var(--fs-xs);\n  color: var(--c-text-muted);\n}\n.detail-qr__hint a {\n  font-weight: var(--fw-medium);\n  display: inline-block;\n  margin-top: var(--sp-1);\n}\n\n/* ---- Metadata table (definition list) ---- */\n.detail-card--meta { margin-bottom: var(--sp-5); }\n.detail-meta {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: var(--sp-2) var(--sp-6);\n  margin: 0;\n}\n.detail-meta__row {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: var(--sp-2) 0;\n  border-bottom: 1px solid var(--c-border-subtle);\n  min-width: 0;\n}\n.detail-meta__label {\n  font-size: var(--fs-xs);\n  color: var(--c-text-muted);\n  font-weight: var(--fw-medium);\n}\n.detail-meta__value {\n  font-size: var(--fs-sm);\n  color: var(--c-text);\n  font-weight: var(--fw-medium);\n  word-break: break-word;\n  margin: 0;\n}\n.detail-meta__value--mono {\n  font-family: var(--font-mono);\n  font-variant-numeric: tabular-nums;\n  letter-spacing: 0.02em;\n}\n\n/* ---- Actions bar ---- */\n.detail-actions {\n  display: flex;\n  gap: var(--sp-2);\n  flex-wrap: wrap;\n  justify-content: center;\n  padding: var(--sp-4) 0;\n  border-top: 1px solid var(--c-border-subtle);\n}\n\n/* ---- Saved button state ---- */\n#detail-save[data-saved=\"1\"] {\n  background: var(--c-accent-soft);\n  color: var(--c-accent);\n  border-color: transparent;\n}\n#detail-save[data-saved=\"1\"]:hover {\n  background: var(--c-accent-soft);\n  opacity: 0.85;\n}\n\n/* ---- Extended identity fields (نام پدر / کد ملی / موبایل) ---- */\n.detail-identity__extra {\n  margin: var(--sp-3) 0 0 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: var(--sp-2) var(--sp-3);\n}\n.detail-identity__extra > div {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.detail-identity__extra dt {\n  font-size: var(--fs-xs);\n  color: var(--c-text-muted, #6b7280);\n  margin: 0;\n}\n.detail-identity__extra dd {\n  font-size: var(--fs-sm);\n  font-weight: var(--fw-medium);\n  word-break: break-word;\n  margin: 0;\n  font-variant-numeric: tabular-nums;\n}\n\n/* ---- Business history table ---- */\n.detail-history__table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--fs-sm);\n  margin-top: var(--sp-2);\n}\n.detail-history__table th,\n.detail-history__table td {\n  padding: var(--sp-2) var(--sp-3);\n  text-align: right;\n  border-bottom: 1px solid var(--c-border-subtle);\n}\n.detail-history__table th {\n  font-weight: var(--fw-medium);\n  color: var(--c-text-muted, #6b7280);\n  font-size: var(--fs-xs);\n}\n.detail-history__table tr:last-child td { border-bottom: none; }\n\n/* ---- Responsive ---- */\n@media (max-width: 768px) {\n  .app-main--detail { padding: var(--sp-4); }\n  .detail-grid { grid-template-columns: 1fr; }\n  .detail-meta { grid-template-columns: 1fr; }\n  .detail-header__actions { width: 100%; }\n  .detail-header__actions .btn { flex: 1; justify-content: center; }\n}\n\n@media print {\n  .app-nav, .detail-header__actions, .detail-actions, .app-footer,\n  #detail-print, #detail-save { display: none !important; }\n  .detail-card { box-shadow: none; border: 1px solid #ccc; }\n  body { background: white; }\n}\n"
