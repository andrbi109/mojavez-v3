            "size": 8805,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"csrf-token\" content=\"0e0c037b988551c729581d2bbe26c813be356afb86e7ed946abcab38cfd1ef00\">\n    <title>درگاه اختصاصی مجوزها</title>\n    <link rel=\"icon\" href=\"/assets/img/favicon.svg\" type=\"image/svg+xml\">\n    <link rel=\"stylesheet\" href=\"/assets/css/tokens.css\">\n    <link rel=\"stylesheet\" href=\"/assets/css/app.css\">\n    <link rel=\"stylesheet\" href=\"/assets/css/cards.css\">\n    <link rel=\"stylesheet\" href=\"/assets/css/tables.css\">\n    \n    \n</head>\n<body>\n    <a class=\"skip-link\" href=\"#main-content\">پرش به محتوای اصلی</a>\n    <nav class=\"app-nav\" aria-label=\"ناوبری اصلی\">\n        <button class=\"app-nav__btn app-nav__btn--icon\" data-action=\"toggle-sidebar\" aria-label=\"باز/بسته کردن پنل فیلترها\" aria-expanded=\"false\" aria-controls=\"sidebar\">☰</button>\n        <div class=\"app-nav__brand\">درگاه مجوزها</div>\n        <a href=\"/dashboard\" class=\"app-nav__link\">داشبورد</a>\n        <a href=\"/\" class=\"app-nav__link is-active\" aria-current=\"page\">جستجو</a>\n        <a href=\"/analytics\" class=\"app-nav__link\">تحلیل</a>\n        <a href=\"/batch\" class=\"app-nav__link\">دسته‌ای</a>\n        <a href=\"/admin\" class=\"app-nav__link\">مدیریت</a>\n        <a href=\"/about\" class=\"app-nav__link\">درباره</a>\n        <div class=\"app-nav__spacer\"></div>\n        <div class=\"view-toggle\" role=\"group\" aria-label=\"نوع نمایش نتایج\">\n            <button class=\"view-toggle__btn is-active\" data-view=\"cards\" type=\"button\" aria-pressed=\"true\">کارت</button>\n            <button class=\"view-toggle__btn\" data-view=\"table\" type=\"button\" aria-pressed=\"false\">جدول</button>\n        </div>\n    </nav>\n\n    <div class=\"app-backdrop\"></div>\n\n        <div class=\"app-layout\">\n        <aside class=\"app-sidebar\" id=\"sidebar\" aria-label=\"فیلترهای جستجو\">\n            <div class=\"app-sidebar__section\">\n                <div class=\"app-sidebar__title\">فیلتر جستجو</div>\n                <form data-form=\"filters\" autocomplete=\"off\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"f-name\">نام / عنوان متقاضی</label>\n                        <input class=\"form-control\" type=\"text\" id=\"f-name\" name=\"name\" placeholder=\"مثلاً: محمد رضایی\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"f-license-id\">شماره مجوز</label>\n                        <input class=\"form-control\" type=\"text\" id=\"f-license-id\" name=\"license_id\" placeholder=\"مثلاً: 24873531\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"f-province\">استان</label>\n                        <select class=\"form-control\" id=\"f-province\" name=\"province_id\">\n                            <option value=\"\">— همه استان‌ها —</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"f-township\">شهرستان</label>\n                        <select class=\"form-control\" id=\"f-township\" name=\"township_id\" disabled>\n                            <option value=\"\">— ابتدا استان را انتخاب کنید —</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"f-main-org\">دستگاه اصلی</label>\n                        <select class=\"form-control\" id=\"f-main-org\" name=\"main_org_code\">\n                            <option value=\"\">— همه دستگاه‌ها —</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"f-sub-org\">دستگاه فرعی</label>\n                        <select class=\"form-control\" id=\"f-sub-org\" name=\"sub_org_code\" disabled>\n                            <option value=\"\">— ابتدا دستگاه اصلی را انتخاب کنید —</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"f-status\">وضعیت</label>\n                        <select class=\"form-control\" id=\"f-status\" name=\"status\">\n                            <option value=\"\">— همه —</option>\n                            <option value=\"active\">معتبر</option>\n                            <option value=\"expired\">منقضی</option>\n                        </select>\n                    </div>\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"f-date-from\">از تاریخ (شمسی)</label>\n                            <input class=\"form-control\" type=\"text\" id=\"f-date-from\" name=\"issue_start_date\" placeholder=\"1400/01/01\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"f-date-to\">تا تاریخ (شمسی)</label>\n                            <input class=\"form-control\" type=\"text\" id=\"f-date-to\" name=\"issue_end_date\" placeholder=\"1405/12/29\">\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <button type=\"submit\" class=\"btn btn--primary\" style=\"width:100%\">جستجوی زنده</button>\n                    </div>\n                    <div class=\"form-group\">\n                        <button type=\"reset\" class=\"btn btn--secondary\" style=\"width:100%\">پاک کردن فیلتر</button>\n                    </div>\n                    <div class=\"form-group\">\n                        <button type=\"button\" class=\"btn btn--ghost btn--sm\" data-action=\"export-csv\" style=\"width:100%\">خروجی CSV</button>\n                    </div>\n                    <div class=\"form-group\">\n                        <button type=\"button\" class=\"btn btn--ghost btn--sm\" data-action=\"save-all\" style=\"width:100%\">★ ذخیره همه نتایج</button>\n                    </div>\n                    <div class=\"form-group\">\n                        <button type=\"button\" class=\"btn btn--ghost btn--sm\" data-action=\"view-saved\" style=\"width:100%\">نمایش ذخیره‌شده‌ها</button>\n                    </div>\n                </form>\n            </div>\n        </aside>\n\n        <main class=\"app-main\" id=\"main-content\">\n            <div class=\"app-main__header\">\n                <div class=\"app-main__title\">نتایج جستجو</div>\n                <div class=\"app-main__count\">۰ مجوز</div>\n                <div class=\"app-main__toolbar\">\n                    <button type=\"button\" class=\"btn btn--ghost btn--sm is-active\" data-action=\"view-all\">همه</button>\n                    <button type=\"button\" class=\"btn btn--ghost btn--sm\" data-action=\"view-saved\">ذخیره‌شده‌ها</button>\n                </div>\n            </div>\n            <div class=\"app-status-bar\">\n                <div class=\"app-status-bar__dot\"></div>\n                <div class=\"app-status-bar__text\">آماده</div>\n            </div>\n            <div id=\"cards-view\">\n                <div id=\"cards-container\" class=\"cards-grid\">\n                    <div class=\"spinner-wrap\">\n                        <div class=\"spinner\"></div>\n                        <div>برای شروع، فیلتر را پر کنید و «جستجوی زنده» را بزنید</div>\n                    </div>\n                </div>\n                <div id=\"cards-pagination-slot\"></div>\n            </div>\n            <div id=\"table-view\" class=\"hidden\">\n                <div id=\"table-container\"></div>\n                <div id=\"pagination\"></div>\n            </div>\n        </main>\n    </div>\n\n    <div class=\"toast-stack\"></div>\n    <div class=\"modal-overlay\"></div>\n\n    <footer class=\"app-footer\">\n        درگاه اختصاصی مجوزها — مبتنی بر داده‌های qr.mojavez.ir\n    </footer>\n\n    <script src=\"/assets/js/app.js\"></script>\n    <script src=\"/assets/js/qrcode-vendor.js\"></script>\n    <script src=\"/assets/js/qr-generator.js\"></script>\n    <script src=\"/assets/js/cards.js\"></script>\n    <script src=\"/assets/js/tables.js\"></script>\n    \n    <script>\n        document.addEventListener('DOMContentLoaded', function () {\n            MojavezApp.init(); MojavezApp.loadLookups();\n        });\n    </script>\n</body>\n</html>"
